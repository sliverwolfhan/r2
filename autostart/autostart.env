# 开机自启动三件套 —— 集中配置
# 被 preflight_check.sh / systemd 单元共用。改这里即可，无需改脚本。

# 需要检测的 USB CDC 设备 (vid:pid)。缺任意一个，预检都不放行。
#   0483:5740 = 虚拟串口 (virtual_serial_port)
#   0483:5741 = 机械臂   (robot_driver)
USB_IDS=("0483:5740" "0483:5741")

# 激光雷达 (Livox MID360)
LIDAR_IP="192.168.1.154"     # 传感器 IP，预检 ping 这个
LIDAR_NIC="enp2s0"           # 连接雷达的网卡
LIDAR_HOST_IP="192.168.1.50" # 主机侧应有的 IP (与 MID360_config.json 一致)

# 预检等待硬件就绪的最长时间(秒)。超时则预检失败、业务服务不启动。
PREFLIGHT_TIMEOUT=120
