<?xml version="1.0"?>
<root BTCPP_format="4" main_tree_to_execute="MainTree">

  <!-- ================== 主树 ==================
       拆分版：抓后立即 lift_block 留在 PICK，其余收尾搬到紧跟的 MOVE 与楼梯并行。 -->
  <BehaviorTree ID="MainTree">
    <Sequence>
      <SetZoneMode node="{node}" mode="2" topic="/AT_R2/zone_mode"/>
      <GetPlan node="{node}"
               topic="/r2_planner/plan"
               plan="{plan}"
               num_steps="{num_steps}"/>

      <!-- PICK 计数器：第 1 块放到车上，第 2 块只举着 -->
      <Script code="pick_count := 0"/>
      <!-- 收尾标志：PICK 抓完置 1，下一个 MOVE 跑完剩余收尾后清 0 -->
      <Script code="need_finish := 0"/>

      <WaitForEnter node="{node}"
                    prompt="参数已设置完成，按 Enter 开始导航"
                    require_tty="true"
                    clear_buffer="true"
                    timeout="0.0"/>

      <Repeat num_cycles="{num_steps}">
        <Sequence>
          <PopNextStep plan="{plan}"
                       step_type="{step_type}"
                       target_id="{target_id}"
                       from_id="{from_id}"
                       prep_x="{prep_x}"
                       prep_y="{prep_y}"
                       prep_yaw="{prep_yaw}"
                       grasp_yaw="{grasp_yaw}"
                       abs_dh="{abs_dh}"
                       stair_dir="{stair_dir}"
                       cube_x="{cube_x}"
                       cube_y="{cube_y}"
                       block_height="{block_h}"/>

          <PeekNextStep plan="{plan}"
                        next_step_type="{next_step_type}"
                        next_target_id="{next_target_id}"
                        next_from_id="{next_from_id}"
                        next_cube_x="{next_cube_x}"
                        next_cube_y="{next_cube_y}"
                        next_block_height="{next_block_height}"/>

          <Switch3 variable="{step_type}"
                   case_1="MOVE"
                   case_2="PICK"
                   case_3="PUSH">
            <SubTree ID="MoveBetweenBlocks" _autoremap="true"/>
            <SubTree ID="PickAtBlock" _autoremap="true"/>
            <SubTree ID="PushAtBlock" _autoremap="true"/>
            <AlwaysFailure/>
          </Switch3>
        </Sequence>
      </Repeat>
    </Sequence>
  </BehaviorTree>

  <!-- ================== MOVE 子树 ==================
       楼梯腿与机械臂腿并行：
       - 楼梯腿：按 stair_dir 爬/下楼；
       - 机械臂腿：PICK 已立即 lift_block，这里做剩余收尾（放置/举着）+ 为下次 PICK 预备 -->
  <BehaviorTree ID="MoveBetweenBlocks">
    <Sequence>
      <ParallelAll max_failures="1">
        <!-- 楼梯腿 -->
        <Switch2 variable="{stair_dir}" case_1="UP" case_2="DOWN">
          <ClimbStair   node="{node}" height="{abs_dh}"/>
          <DescendStair node="{node}" height="{abs_dh}"/>
          <AlwaysSuccess/>
        </Switch2>

        <!-- 机械臂腿（兜底成功，不影响楼梯/MOVE 整体） -->
        <ForceSuccess>
          <Sequence>
            <!-- (1) 抓后剩余收尾：仅当上一步刚抓完(need_finish==1) -->
            <Switch2 variable="{need_finish}" case_1="1" case_2="0">
              <Sequence>
                <Switch2 variable="{pick_count}" case_1="1" case_2="2">
                  <!-- 第 1 块：放到车上（lift_block 已在 PICK 完成） -->
                  <Sequence>
                    <ArmMoveNamed node="{node}" pose_name="stow_block"  server_name="robotic_task" task_id="1" duration="2.5"/>
                    <ArmMoveNamed node="{node}" pose_name="place_block" server_name="robotic_task" task_id="1"/>
                    <PublishPumpCmd node="{node}" command="0"/>
                    <DelayMs delay_msec="1500">
                      <AlwaysSuccess/>
                    </DelayMs>
                    <ArmMoveNamed node="{node}" pose_name="stow_block"  server_name="robotic_task" task_id="1"/>
                    <ArmMoveNamed node="{node}" pose_name="lift_block"  server_name="robotic_task" task_id="1"/>
                  </Sequence>
                  <!-- 第 2 块：只举着 -->
                  <Sequence>
                    <ArmMoveNamed node="{node}" pose_name="hold_block"  server_name="robotic_task" task_id="1"/>
                  </Sequence>
                  <!-- default：兜底举着 -->
                  <Sequence>
                    <ArmMoveNamed node="{node}" pose_name="hold_block"  server_name="robotic_task" task_id="1"/>
                  </Sequence>
                </Switch2>
                <Script code="need_finish := 0"/>
              </Sequence>
              <AlwaysSuccess/>
              <AlwaysSuccess/>
            </Switch2>

            <!-- (2) 预备：下一步是 PICK 才把手臂摆到下一次抓取的预备姿势 -->
            <Switch2 variable="{next_step_type}" case_1="PICK" case_2="__never__">
              <Sequence>
                <SelectArmPrepName next_from_id="{next_from_id}"
                                   next_target_id="{next_target_id}"
                                   arm_prep_name="{arm_prep_name}"/>
                <ArmMoveNamed node="{node}"
                              pose_name="{arm_prep_name}"
                              server_name="robotic_task"
                              task_id="1"/>
              </Sequence>
              <AlwaysSuccess/>
              <AlwaysSuccess/>
            </Switch2>
          </Sequence>
        </ForceSuccess>
      </ParallelAll>
    </Sequence>
  </BehaviorTree>

  <!-- ================== PICK 子树 ==================
       拆分版：对齐 + 开泵 + ArmTask 抓取 + 立即 lift_block。
         - lift_block 必须在 PICK 内立即执行：先把方块从抓取面抬起，避免随后移动时拖拽/碰撞；
         - 其余收尾（stow/place/pump off/hold）放到紧跟的 MOVE，与楼梯并行；
         - pick_count 自增，need_finish 置 1 通知下一个 MOVE 跑剩余收尾。 -->
  <BehaviorTree ID="PickAtBlock">
    <Sequence>
      <Script code="pick_count += 1"/>

      <PreSteerAlign node="{node}" vx="0.1" duration="0.01" publish_rate_hz="50"/>
      <PublishPumpCmd node="{node}" command="1"/>
      <ArmTask node="{node}"
               task_id="2"
               server_name="robotic_task"
               base_frame="base_link"
               target_frame="target_object"
               map_frame="map"
               tf_timeout="1.0"
               cube_x="{cube_x}"
               cube_y="{cube_y}"
               block_height="{block_h}"
               grasp_height="{block_h}"
               goal_data="{arm_goal_data}"
               err_code="{arm_err_code}"
               reason="{arm_reason}"/>

      <!-- 抓后立即抬起，确保移动安全；剩余收尾交给紧跟的 MOVE -->
      <ArmMoveNamed node="{node}" pose_name="lift_block" server_name="robotic_task" task_id="1"/>

      <Script code="need_finish := 1"/>
    </Sequence>
  </BehaviorTree>

  <!-- ================== PUSH 子树 ================== -->
  <BehaviorTree ID="PushAtBlock">
    <Sequence>
      <PublishGoal node="{node}"
                   x="{prep_x}" y="{prep_y}" yaw="{prep_yaw}"
                   frame_id="map"
                   goal="{nav_goal}"/>
      <PreSteerAlign node="{node}" vx="0.1" duration="0.1" publish_rate_hz="50"/>
      <ArmTask node="{node}"
               task_id="3"
               server_name="robotic_task"
               base_frame="base_footprint"
               target_frame="target_object"
               map_frame="map"
               tf_timeout="5.0"
               cube_x="{cube_x}"
               cube_y="{cube_y}"
               block_height="{block_h}"
               grasp_height="0.0"
               goal_data="{arm_goal_data}"
               err_code="{arm_err_code}"
               reason="{arm_reason}"/>
    </Sequence>
  </BehaviorTree>

</root>
