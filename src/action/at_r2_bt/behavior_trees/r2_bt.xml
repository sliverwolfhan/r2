<?xml version="1.0"?>
<root BTCPP_format="4" main_tree_to_execute="MainTree">

  <!-- ================== 主树 ================== -->
  <BehaviorTree ID="MainTree">
    <Sequence>

      <SetMppiParams node="{node}"
              controller_node="/AT_R2/controller_server"
              plugin_prefix="FollowPath"
              goal_angle_weight="6.0"
              wait_after_set="0.3"
              goal_angle_threshold="2.0"
              wz_std="0.5"
              vx_std="0.5"
              vy_std="0.5"/>
      <SetCostmapInflation node="{node}"
                          local_radius="0.3"
                          global_radius="0.3"
                          local_cost_scaling_factor="1.0"
                          global_cost_scaling_factor="4.0"/>
      <!-- <Sequence name="ThroughNarrowGate">
        <SetCostmapInflation node="{node}"
                            local_radius="0.05"
                            global_radius="0.15"
                            local_cost_scaling_factor="5.0"
                            global_cost_scaling_factor="5.0"/>
        <PublishGoal node="{node}" x="1.3" y="-5.2" yaw="1.57" frame_id="map" goal="{goal}"/>
        <PublishGoal node="{node}" x="1.3" y="-5.35" yaw="1.57" frame_id="map" goal="{goal}"/>
        <PublishGoal node="{node}" x="1.3" y="-4.0" yaw="-1.57" frame_id="map" goal="{goal}"/>
        <SetCostmapInflation node="{node}"
                            local_radius="0.3"
                            global_radius="0.3"
                            local_cost_scaling_factor="1.0"
                            global_cost_scaling_factor="4.0"/>
        <SetMppiParams node="{node}"
              controller_node="/AT_R2/controller_server"
              plugin_prefix="FollowPath"
              wait_after_set="0.3"
              wz_std="0.5"
              vx_std="0.5"
              vy_std="0.5"/>
      </Sequence> -->

      <Sequence>
        <GetPlan node="{node}"
                topic="/r2_planner/plan"
                plan="{plan}"
                num_steps="{num_steps}"/>

        <Repeat num_cycles="{num_steps}">
            <Sequence>
            <PopNextStep plan="{plan}"
                        step_type="{step_type}"
                        target_id="{target_id}"
                        from_id="{from_id}"
                        prep_x="{prep_x}"
                        prep_y="{prep_y}"
                        prep_yaw="{prep_yaw}"
                        grasp_yaw="{grasp_yaw}"
                        abs_dh="{abs_dh}"
                        stair_dir="{stair_dir}"
                        cube_x="{cube_x}"
                        cube_y="{cube_y}"
                        block_height="{block_h}"/>

            <Switch3 variable="{step_type}"
                    case_1="MOVE"
                    case_2="PICK"
                    case_3="PUSH">
                <SubTree ID="MoveBetweenBlocks" _autoremap="true"/>
                <SubTree ID="PickAtBlock" _autoremap="true"/>
                <SubTree ID="PushAtBlock" _autoremap="true"/>
                <AlwaysFailure/>
            </Switch3>
            </Sequence>
        </Repeat>
      </Sequence>

      <Sequence>
        <SetCostmapInflation node="{node}"
                    local_radius="0.45"
                    global_radius="0.45"
                    local_cost_scaling_factor="1.0"
                    global_cost_scaling_factor="4.0"/>
        <SetMppiParams node="{node}"
                    controller_node="/AT_R2/controller_server"
                    plugin_prefix="FollowPath"
                    goal_angle_weight="5.0"
                    goal_angle_threshold="0.3"
                    wait_after_set="0.3"
                    wz_std="0.45"
                    vx_std="0.45"
                    vy_std="0.45"/>
        <PublishGoal node="{node}" x="8.6" y="-0.7" yaw="0.0" frame_id="map" goal="{goal}"/>
        <PublishGoal node="{node}" x="11.45" y="-0.7" yaw="0.0" frame_id="map" goal="{goal}"/>
        <SetMppiParams node="{node}"
                    controller_node="/AT_R2/controller_server"
                    plugin_prefix="FollowPath"
                    goal_angle_threshold="1.0"
                    wait_after_set="0.3"/>
        <PublishGoal node="{node}" x="10.75" y="-3.0" yaw="-1.57" frame_id="map" goal="{goal}"/>
      </Sequence>
    </Sequence>
  </BehaviorTree>

  <!-- ================== MOVE 子树 ==================
       预备点 = 当前方块的中心，朝向 = 指向目标方块；
       PreSteerAlign 让舵轮对齐；按 stair_dir 决定上/下楼或平移。 -->
  <BehaviorTree ID="MoveBetweenBlocks">
    <Sequence>
      <Fallback>
        <IsPrepSkippable node="{node}"
                  target_x="{prep_x}"
                  target_y="{prep_y}"
                  target_yaw="{prep_yaw}"
                  x_tolerance="0.20"
                  y_tolerance="0.20"
                  yaw_tolerance="0.05"
                  base_frame="base_footprint"/>
        <Sequence>
          <PublishGoal node="{node}"
                      x="{prep_x}" y="{prep_y}" yaw="{prep_yaw}"
                      frame_id="map"
                      goal="{nav_goal}"/>
                      
          <!-- <PreSteerAlign node="{node}" vx="0.1" duration="0.0" publish_rate_hz="50"/> -->
        </Sequence>
      </Fallback>
      <Switch2 variable="{stair_dir}" case_1="UP" case_2="DOWN">
        <ClimbStair   node="{node}" height="{abs_dh}"/>
        <DescendStair node="{node}" height="{abs_dh}"/>
        <AlwaysSuccess/>
      </Switch2>
    </Sequence>
    
  </BehaviorTree>

  <!-- ================== PICK 子树 ==================
       和 MOVE 一样先把机器人摆到 prep_pose 上对齐到 target 那一侧，再伸臂抓。 -->
  <BehaviorTree ID="PickAtBlock">
    <Sequence>
      <!-- <PublishGoal node="{node}"
                   x="{prep_x}" y="{prep_y}" yaw="{grasp_yaw}"
                   frame_id="map"
                   goal="{nav_goal}"/> -->
      <!-- <PreSteerAlign node="{node}" vx="0.1" duration="0.1" publish_rate_hz="50"/> -->
      <ArmTask node="{node}"
               task_id="2"
               server_name="robotic_task"
               base_frame="base_link"
               target_frame="target_object"
               map_frame="map"
               tf_timeout="1.0"
               cube_x="{cube_x}"
               cube_y="{cube_y}"
               block_height="{block_h}"
               grasp_height="{block_h}"
               goal_data="{arm_goal_data}"
               err_code="{arm_err_code}"
               reason="{arm_reason}"/>
    </Sequence>
  </BehaviorTree>

  <!-- ================== PUSH 子树 ================== -->
  <BehaviorTree ID="PushAtBlock">
    <Sequence>
      <PublishGoal node="{node}"
                   x="{prep_x}" y="{prep_y}" yaw="{prep_yaw}"
                   frame_id="map"
                   goal="{nav_goal}"/>
      <PreSteerAlign node="{node}" vx="0.1" duration="0.1" publish_rate_hz="50"/>
      <ArmTask node="{node}"
               task_id="3"
               server_name="robotic_task"
               base_frame="base_footprint"
               target_frame="target_object"
               map_frame="map"
               tf_timeout="5.0"
               cube_x="{cube_x}"
               cube_y="{cube_y}"
               block_height="{block_h}"
               grasp_height="0.0"
               goal_data="{arm_goal_data}"
               err_code="{arm_err_code}"
               reason="{arm_reason}"/>
    </Sequence>
  </BehaviorTree>

</root>
