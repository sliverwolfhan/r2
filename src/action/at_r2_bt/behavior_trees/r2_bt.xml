<?xml version="1.0"?>
<root BTCPP_format="4" main_tree_to_execute="MainTree">

  <!-- ================== R2 总流程 ==================
       直接组合两棵已有子行为树:
         1. GraspHead       (grasp_head.xml)       —— 抓武器头 + 对接
         2. MeilinMission   (meilin_mission.xml)   —— 梅林区域块导航/抓取/推
       子树内部各自负责自己的 SetZoneMode / MPPI / Costmap / WaitForEnter,
       这里只做串行编排，避免参数重复维护。 -->
  <include path="grasp_head.xml"/>
  <include path="meilin_mission.xml"/>

  <BehaviorTree ID="MainTree">
    <Sequence>
      <SubTree ID="GraspHead"     _autoremap="true"/>
      <SubTree ID="MeilinMission" _autoremap="true"/>
    </Sequence>
  </BehaviorTree>

</root>
