<?xml version="1.0"?>
<root BTCPP_format="4" main_tree_to_execute="GraspHeadRedMatch">

  <!-- ================== 红区竞技赛(单项赛) 抓武器头 ==================
       与 grasp_head_red.xml 同一套"武器头爪子", 话题 /AT_R2/head_gripper_cmd (Int32):
         1 = 准备抓取(张开爪子)   2 = 抓取   3 = 抬起武器头   4 = 对接交付
         5 = 后退播报   6 = (预留)   7 = 松爪

       竞技赛规则: 只需成功抓取一个武器头。闭爪后 *主动等抓取结果反馈*,
       成功才走后续, 失败就从激光对齐重来(最多 3 次)。

       抓取结果判定(两话题组合, 与蓝区 grasp_head_blue_match.xml *完全相反*):
         抓成功 = /AT_R2/meilin_mission_start==0 且 /AT_R2/zone3_cmd==1
         抓失败 = /AT_R2/meilin_mission_start==1 且 /AT_R2/zone3_cmd==0
         其它任意组合 -> 继续等待

       流程:
         全局: 模式 / 代价地图 / MPPI 一次性设置, 一键启动门控 (red_start_cmd)
         A/B/C: 导航到 prep 点 -> 张爪(cmd=1) -> 侧向贴靠柜台 (一次性)
         D+抓取+等结果 (RetryUntilSuccessful 最多 3 次):
           D. 激光精对齐 -> 抓取(cmd=2)闭爪 -> WaitGraspResult 判成败
              成功 -> 子 Sequence 成功 -> 退出重试
              失败 -> 子 Sequence 失败 -> 回到 D 段重来 (最多 3 次)
           外层 ForceSuccess: 3 次仍失败也放行, 仍继续后续动作
         后续: 抬起(cmd=3) -> 对接(cmd=4) -> 后退(cmd=5) + 导航退到交付点 ->
               等对接完成(docking_status==1 或按 Enter) -> 松爪(cmd=7)

       prep 点/激光目标距离读黑板扁平工作键(grasp_prep_* / grasp_laser_target_distance),
       由 simple_bt_runner.cpp 把 weapon_priority 第一个武器加载为无前缀键提供, 只抓一个,
       无需 SelectWeaponParams。
  -->
  <BehaviorTree ID="GraspHeadRedMatch">
    <Sequence>

      <!-- ===== 全局一次性设置: 模式 / 代价地图 / MPPI ===== -->
      <SetZoneMode node="{node}" mode="1" topic="/AT_R2/zone_mode"/>

      <SetCostmapInflation node="{node}"
                    local_radius="0.001"
                    global_radius="0.001"
                    local_cost_scaling_factor="5.0"
                    global_cost_scaling_factor="5.0"/>
      <SetMppiParams node="{node}"
               controller_node="/AT_R2/controller_server"
               plugin_prefix="FollowPath"
               goal_angle_weight="6.0"
               goal_angle_threshold="2.0"
               vx_max="1.2"
               vx_min="-1.2"
               vy_max="1.2"
               wz_max="4.0"
               vx_std="0.4"
               vy_std="0.4"
               wz_std="0.4"
               pathalign_threshold="3.0"
               pathalign_offset_from_furthest="15"
               goal_x_tolerance="0.03"
               goal_y_tolerance="0.05"
               goal_yaw_tolerance="0.05"
               goal_stable_duration="0.3"
               pathalign_use_path_orientations="false"
               wait_after_set="0.2"/>

      <!-- 一键启动门控: 按 Enter 或发布 /AT_R2/red_start_cmd 任一即开始。 -->
      <WaitForStart node="{node}"
                    prompt="参数已设置完成，按 Enter 或发布 /AT_R2/red_start_cmd 开始竞技赛抓取武器头"
                    start_topic="/AT_R2/red_start_cmd"
                    start_value="1"
                    enable_topic="true"
                    clear_buffer="true"
                    timeout="0.0"/>

      <!-- ===== A/B. 导航到武器 prep 点 ===== -->
      <PublishGoal node="{node}"
              x="{grasp_prep_x}" y="{grasp_prep_y}" yaw="{grasp_prep_yaw}"
              frame_id="map"
              goal="{nav_goal}"/>

      <!-- ===== C. 张爪(cmd=1) + 侧向贴靠柜台(激光判贴住) ===== -->
      <ParallelAll max_failures="1">
        <PublishHeadCmd node="{node}" command="1"
                        topic="/AT_R2/head_gripper_cmd"
                        wait_done="false"/>
        <Sequence>
          <DelayMs delay_msec="200">
              <AlwaysSuccess/>
          </DelayMs>
          <ForceSuccess>
            <DockToWall node="{node}"
                        vy="-0.15"
                        vx="0.0"
                        wz="0.0"
                        stall_threshold="0.05"
                        stall_duration="0.4"
                        timeout="5.0"
                        publish_rate_hz="50.0"
                        cmd_vel_topic="/AT_R2/cmd_vel_bt"
                        odom_topic="/AT_R2/odometry"
                        distance_topic="/AT_R2/distance_grasp"
                        distance_scale="0.001"
                        distance_stall_max="0.030"
                        filter_enable="true"
                        median_window="5"
                        ema_tau="0.1"/>
          </ForceSuccess>
        </Sequence>
      </ParallelAll>

      <!-- ===== D + 抓取 + 等结果: 失败从激光对齐重来, 最多 3 次 =====
           RetryUntilSuccessful: 子 Sequence 返回 FAILURE 时重跑, 最多 num_attempts 次;
           WaitGraspResult 成功(SUCCESS) -> Sequence 成功 -> 退出重试;
                           失败(FAILURE) -> Sequence 失败 -> 回到 D 段重来。
           外层 ForceSuccess: 3 次都失败也放行, 仍继续后续抬起/对接动作。 -->
      <Script code="retry_grasp := 0"/>
      <ForceSuccess>
        <RetryUntilSuccessful num_attempts="3">
          <Sequence>

            <!-- 张开爪子(cmd=10): 仅失败重试时张爪(首轮 C 段已发 cmd=1 张开, 无需重复)。
                 retry_grasp==0(首轮) 跳过; ==1(重试) 才张爪并留 500ms 等爪子物理张开到位,
                 避免 D 段瞬间通过时紧接 cmd=2 闭爪。 -->
            <Fallback>
              <ScriptCondition code="retry_grasp == 0"/>
              <Sequence>
                <PublishHeadCmd node="{node}" command="10"
                                topic="/AT_R2/head_gripper_cmd"
                                wait_done="false"/>
                <DelayMs delay_msec="500">
                  <AlwaysSuccess/>
                </DelayMs>
              </Sequence>
            </Fallback>
            <!-- 标记后续均为重试轮 -->
            <Script code="retry_grasp := 1"/>

            <!-- D. 激光对距精对齐: 已在范围内直接过, 否则伺服对齐 (红区用 distance_head) -->
            <Fallback>
              <GraspReadyByPoseDistance node="{node}"
                                        map_frame="map"
                                        base_frame="base_footprint"
                                        target_y="{grasp_prep_y}"
                                        y_tolerance="{grasp_prep_y_tolerance}"
                                        target_yaw="{grasp_prep_yaw}"
                                        yaw_tolerance="{grasp_prep_yaw_tolerance}"
                                        distance_topic="/AT_R2/distance_head"
                                        distance_scale="0.001"
                                        target_distance="{grasp_laser_target_distance}"
                                        distance_tolerance="0.01"
                                        stable_count="3"
                                        max_data_age="0.5"/>

              <DistanceServoAlign node="{node}"
                                  distance_topic="/AT_R2/distance_head"
                                  distance_scale="0.001"
                                  target_distance="{grasp_laser_target_distance}"
                                  tolerance="0.01"
                                  kp="0.8"
                                  max_speed="0.2"
                                  min_speed="0.015"
                                  stable_count="2"
                                  max_data_age="0.5"
                                  timeout="8.0"
                                  publish_rate_hz="50.0"
                                  cmd_axis="x"
                                  positive_error_direction="-1.0"
                                  side_speed_scale="0.7"
                                  side_speed_direction="-1.0"
                                  filter_enable="true"
                                  median_window="3"
                                  ema_tau="0.1"
                                  cmd_vel_topic="/AT_R2/cmd_vel_nav2_result"/>
            </Fallback>

            <!-- 抓取(闭爪) -->
            <PublishHeadCmd node="{node}" command="2"
                            topic="/AT_R2/head_gripper_cmd"
                            wait_done="false"/>
            <DelayMs delay_msec="600">
              <AlwaysSuccess/>
            </DelayMs>

            <!-- 等抓取结果(两话题组合判定, 与蓝区完全相反):
                   成功 = meilin_mission_start==0 且 zone3_cmd==1 -> SUCCESS(退出重试);
                   失败 = meilin_mission_start==1 且 zone3_cmd==0 -> FAILURE(回到 D 段重来);
                   其它任意组合 -> 继续等待。
                 timeout>0 时超时按失败重试(timeout_result 默认 FAILURE);
                 现场按下位机反馈快慢调 timeout, =0.0 则无限等一个明确结果。 -->
            <WaitGraspResult node="{node}"
                             topic_a="/AT_R2/meilin_mission_start"
                             topic_b="/AT_R2/zone3_cmd"
                             success_a="0"
                             success_b="1"
                             fail_a="1"
                             fail_b="0"
                             timeout="0.0"
                             timeout_result="false"/>

          </Sequence>
        </RetryUntilSuccessful>
      </ForceSuccess>

      <!-- ===== 闭爪成功后的后续动作: 抬起 -> 对接 -> 后退 -> 交付 ===== -->
      <PublishHeadCmd node="{node}" command="3"
                      topic="/AT_R2/head_gripper_cmd"
                      wait_done="false"/>
      <DelayMs delay_msec="1200">
        <AlwaysSuccess/>
      </DelayMs>

      <!-- 对接交付: 抬起后再退, 避免武器头还在柜台上就拖动 -->
      <ForceSuccess>
        <PublishHeadCmd node="{node}" command="4"
                        topic="/AT_R2/head_gripper_cmd"
                        wait_done="false"
                        timeout="1.0"/>
      </ForceSuccess>

      <!-- 后退播报(cmd=5 -> cmd=6) 并导航退到交付点 (红区: FollowSpinPath 到 (1.3,4.0,0.0)) -->
      <ParallelAll max_failures="1">
        <Sequence>
          <DelayMs delay_msec="500">
            <AlwaysSuccess/>
          </DelayMs>
          <PublishHeadCmd node="{node}" command="5"
                  topic="/AT_R2/head_gripper_cmd"
                  wait_done="false"/>
          <DelayMs delay_msec="1000">
            <AlwaysSuccess/>
          </DelayMs>
          <PublishHeadCmd node="{node}" command="6"
                topic="/AT_R2/head_gripper_cmd"
                wait_done="false"/>
        </Sequence>
        <Sequence>
            <SetMppiParams node="{node}"
                     controller_node="/AT_R2/controller_server"
                     plugin_prefix="FollowPath"
                     goal_angle_weight="6.0"
                     goal_angle_threshold="2.0"
                     vx_max="1.2"
                     vx_min="-1.2"
                     vy_max="1.2"
                     wz_max="4.0"
                     vx_std="0.3"
                     vy_std="0.3"
                     wz_std="0.5"
                     goal_x_tolerance="0.05"
                     goal_y_tolerance="0.05"
                     goal_yaw_tolerance="0.08"
                     goal_stable_duration="0.3"
                     pathalign_use_path_orientations="true"
                     wait_after_set="0.2"/>
            <FollowSpinPath node="{node}"
                            goal_x="1.3"
                            goal_y="4.0"
                            goal_yaw="0.0"
                            rotation_start_distance="0.45"
                            rotation_end_distance="0.45"
                            rotation_direction="ccw"
                            num_points="150"
                            frame_id="map"
                            map_frame="map"
                            base_frame="base_footprint"
                            tf_timeout="0.5"
                            tf_namespace="AT_R2"
                            action_name="/AT_R2/follow_path"
                            controller_id="FollowPath"
                            goal_checker_id="general_goal_checker"
                            goal="{spin_goal}"/>
        </Sequence>
      </ParallelAll>

      <!-- 等对接完成后松爪 cmd=7: 操作员按 Enter, 或收到 /AT_R2/docking_status == 1,
           任一满足即松爪(只松一次)。竞技赛只抓一个, 目标状态固定为 1。 -->
      <Parallel success_count="1" failure_count="2">
        <Sequence>
          <WaitForEnter node="{node}"
                        prompt="对接完成后按 Enter 松爪 (cmd=7), 或等下位机发布 docking_status"
                        require_tty="true"
                        clear_buffer="true"
                        timeout="0.0"/>
          <PublishHeadCmd node="{node}" command="7"
                          topic="/AT_R2/head_gripper_cmd"
                          wait_done="false"/>
        </Sequence>
        <WaitDockingRelease node="{node}"
                            status_topic="/AT_R2/docking_status"
                            gripper_topic="/AT_R2/head_gripper_cmd"
                            target_status="1"
                            release_cmd="7"
                            timeout="1000.0"/>
      </Parallel>
      <DelayMs delay_msec="1300">
        <AlwaysSuccess/>
      </DelayMs>

    </Sequence>
  </BehaviorTree>
</root>
