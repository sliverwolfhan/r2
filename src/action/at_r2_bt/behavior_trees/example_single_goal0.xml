<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4"
      main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <Sequence name="StairClimbingMission">
      
      <!-- 爬楼梯路径 -->
      <Sequence name="Climb1">
        <PublishGoal node="{node}" x="2.9" y="3.0" yaw="0.0"/>
        <ClimbStair node="{node}" height="0.25"/>
      </Sequence>
      
      <Sequence name="Climb2">
        <PublishGoal node="{node}" x="3.8" y="3.0" yaw="1.57"/>
        <ClimbStair node="{node}" height="0.25"/>
      </Sequence>
      
      <Sequence name="Climb3">
        <PublishGoal node="{node}" x="3.8" y="4.2" yaw="0"/>
        <ClimbStair node="{node}" height="0.25"/>
      </Sequence>
      
      <!-- 下楼梯路径 -->
      <Sequence name="Descend1">
        <PublishGoal node="{node}" x="5.0" y="4.2" yaw="3.14"/>
        <DescendStair node="{node}" height="0.2"/>
      </Sequence>
      
      <Sequence name="Descend2">
        <PublishGoal node="{node}" x="6.2" y="4.2" yaw="3.14"/>
        <DescendStair node="{node}" height="0.2"/>
      </Sequence>
      
      <Sequence name="Descend3">
        <PublishGoal node="{node}" x="7.4" y="4.2" yaw="3.14"/>
        <DescendStair node="{node}" height="0.2"/>
      </Sequence>
      
      <!-- 最终导航 -->
      <PublishGoal node="{node}" x="8.6" y="4.2" yaw="-1.57"/>
      <PublishGoal node="{node}" x="8.6" y="0.6" yaw="0"/>
      
    </Sequence>
  </BehaviorTree>

  <!-- 描述节点模型 -->
  <TreeNodesModel>
    <Action ID="ClimbStair" editable="true">
      <input_port name="height"/>
    </Action>
    <Action ID="DescendStair" editable="true">
      <input_port name="height"/>
    </Action>
    <Action ID="PublishGoal" editable="true">
      <input_port name="x"/>
      <input_port name="y"/>
      <input_port name="yaw"/>
    </Action>
  </TreeNodesModel>
</root>
