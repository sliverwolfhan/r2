<?xml version="1.0"?>
<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <Sequence name="MultiGoalPatrol">
      <!-- First goal -->
       <!-- <PublishGoal node="{node}" x="8.7" y="-4.20" yaw="3.14" frame_id="map" goal="{goal}"/>
       <PreSteerAlign node="{node}" vx="0.1" duration="0.1"/> -->

      <!-- Second goal -->
       <!-- <PublishGoal node="{node}" x="8.6" y="-4.2" yaw="3.14" frame_id="map" goal="{goal}"/> -->
      <Sequence name="Climb1">
        <PublishGoal node="{node}" x="8.6" y="-4.2" yaw="3.14"/>
        <PreSteerAlign node="{node}" vx="0.1" duration="0.1"/>
        <ClimbStair node="{node}" height="0.25"/>
      </Sequence>
      <!-- <PublishGoal node="{node}" x="7.4" y="-4.20" yaw="3.14" frame_id="map" goal="{goal}"/> -->

      <!-- Third goal -->
      <Sequence name="Climb2">
        <PublishGoal node="{node}" x="7.4" y="-4.2" yaw="3.14"/>
        <PreSteerAlign node="{node}" vx="0.1" duration="0.1"/>
        <ClimbStair node="{node}" height="0.25"/>
      </Sequence>
      <!-- Return to start -->
       <!-- <PublishGoal node="{node}" x="2.0" y="5.0" yaw="0.0" frame_id="map" goal="{goal}"/> -->
      <!-- <PublishGoal node="{node}" x="6.2" y="-4.20" yaw="1.57" frame_id="map" goal="{goal}"/> -->
      <Sequence name="Climb3">
        <PublishGoal node="{node}" x="6.2" y="-4.2" yaw="1.57"/>
        <PreSteerAlign node="{node}" vx="0.1" duration="0.1"/>
        <ClimbStair node="{node}" height="0.25"/>
      </Sequence>
      <!-- <PublishGoal node="{node}" x="6.2" y="-3.0" yaw="0.0" frame_id="map" goal="{goal}"/> -->
      <Sequence name="Descend1">
        <PublishGoal node="{node}" x="6.2" y="-3.0" yaw="0.0"/>
        <PreSteerAlign node="{node}" vx="0.1" duration="0.1"/>
        <DescendStair node="{node}" height="0.21"/>
      </Sequence>
      <Sequence name="Descend2">
        <PublishGoal node="{node}" x="7.4" y="-3.0" yaw="-1.57"/>
        <PreSteerAlign node="{node}" vx="0.1" duration="0.1"/>
        <DescendStair node="{node}" height="0.21"/>
      </Sequence>
      <Sequence name="Descend3">
        <PublishGoal node="{node}" x="7.4" y="-4.2" yaw="0.0"/>
        <PreSteerAlign node="{node}" vx="0.1" duration="0.1"/>
        <DescendStair node="{node}" height="0.21"/>
      </Sequence>
    </Sequence>
  </BehaviorTree>
</root>
