<?xml version="1.0"?>
<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <Sequence name="PlaceKFS">

      <!-- 1. 机械臂摆放置姿态（夹着 KFS）。task_id=1 走 move_kfs 关节运动。 -->
      <ArmMoveNamed node="{node}"
                    pose_name="place_interim_pos_0"
                    server_name="robotic_task"
                    task_id="1"
                    duration="2.0"/>

      <!-- 2. 导航到预备点：对齐格子。x/y 单位 m，yaw 单位 rad（map 系）。 -->
      <PublishGoal node="{node}"
                   x="0.0"
                   y="0.0"
                   yaw="0.0"
                   frame_id="map"
                   action_name="/AT_R2/navigate_to_pose"
                   goal="{prep_goal}"/>

      <!-- 3. 导航到放置点：往前进把 KFS 怼进格子。 -->
      <PublishGoal node="{node}"
                   x="0.0"
                   y="0.0"
                   yaw="0.0"
                   frame_id="map"
                   action_name="/AT_R2/navigate_to_pose"
                   goal="{place_goal}"/>

      <!-- 4. 松气泵，放下 KFS。 -->
      <PublishPumpCmd node="{node}" command="0" topic="/AT_R2/pump_cmd"/>

      <!-- 松气泵后等 1s，等 KFS 完全脱开再动。 -->
      <DelayMs delay_msec="1000">
        <AlwaysSuccess/>
      </DelayMs>

      <!-- ===== 退回预备点，同时机械臂从车上取第二个块 ===== -->
      <ParallelAll max_failures="1">

        <!-- 腿1：底盘退回原先的预备点（与第一个块的预备点相同坐标）。 -->
        <PublishGoal node="{node}"
                     x="0.0"
                     y="0.0"
                     yaw="0.0"
                     frame_id="map"
                     action_name="/AT_R2/navigate_to_pose"
                     goal="{prep_goal_2}"/>

        <!-- 腿2：机械臂从车上取第二个块：去 touch 位 → 开气泵吸住 → 回放置姿态。 -->
        <Sequence>
          <ArmMoveNamed node="{node}"
                        pose_name="kfs1_touch_pos"
                        server_name="robotic_task"
                        task_id="1"
                        duration="2.0"/>
          <PublishPumpCmd node="{node}" command="1" topic="/AT_R2/pump_cmd"/>
          <DelayMs delay_msec="1000">
            <AlwaysSuccess/>
          </DelayMs>
          <ArmMoveNamed node="{node}"
                        pose_name="place_interim_pos_0"
                        server_name="robotic_task"
                        task_id="1"
                        duration="2.0"/>
        </Sequence>

      </ParallelAll>


    </Sequence>
  </BehaviorTree>
</root>
