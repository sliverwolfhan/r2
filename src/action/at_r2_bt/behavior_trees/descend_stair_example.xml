<?xml version="1.0"?>
<root BTCPP_format="4">
  <!-- 
    下楼梯示例行为树
    
    功能：
    - 下降指定高度的楼梯
    - 监听状态反馈
    - 返回成功或失败
    
    使用方法：
    ros2 run nav2_bt_publish_goal simple_bt_runner \
      --ros-args -p bt_xml:=descend_stair_example.xml
  -->
  
  <BehaviorTree ID="DescendStairExample">
    <Sequence>
      <!-- 下楼梯动作 -->
      <DescendStair 
        height="0.3" 
        descend_height="{descend_height}"
        node="{node}"/>
      
      <!-- 成功后的动作 -->
      <AlwaysSuccess/>
    </Sequence>
  </BehaviorTree>
</root>
