<?xml version="1.0"?>
<root BTCPP_format="4" main_tree_to_execute="PlaceMission">
  <!--
    ================== 红区竞技赛(单项赛) 放块 ==================
    初始状态(进三区前, 车上共 2 块):
      - 手上块: 机械臂 hold_block_red 抓着, 顶端气泵 /AT_R2/pump_cmd=1 吸着;
      - 底盘块: 底盘气泵 /AT_R2/chassis_pump_cmd=1 吸着。

    流程 (线性, 不循环; 竞技赛固定 2 块):
      A. 全局设置(mode=3 / costmap / MPPI) -> 预装 hold_block_red + pump=1
         -> 等 red_start_cmd 启动 -> 导航进三区 -> 等 zone3_cmd 放行 -> 导航到放置准备位。
      B. 第一次等 place_slot_select (1/2/3=格子) -> 放【手上块】到所选格子
         (照 v5 case1/2/3: 激光对齐 + DockToWall 怼格子 + pump=0 松开 + 倒车退出收臂)。
      C. 机械臂从底盘取下【底盘块】(照 v2 "从车上取" 套动作: 机械臂 pump=1 吸住
         -> chassis_pump=0 底盘松开 -> 抬起到过渡位)。
      D. 第二次等 place_slot_select:
           1/2/3 = 放第二层格子 -> 照 v5 case1/2/3 放【底盘块】到所选格子;
           4     = 大胜爬三层     -> 照 v5 case4 爬三层放块结束。

    slot_x/y/yaw 由 WaitSlotSelect 按收到的值(1/2/3)从黑板 slot_<v>_* 拷到工作键。
  -->
  <BehaviorTree ID="PlaceMission">
    <Sequence name="PlaceKFS">

      <!-- ===== 全局一次性设置: 模式 / 代价地图 / MPPI ===== -->
      <SetZoneMode node="{node}" mode="3" topic="/AT_R2/zone_mode"/>

      <SetCostmapInflation node="{node}"
          local_radius="0.30"
          global_radius="0.30"
          local_cost_scaling_factor="1.0"
          global_cost_scaling_factor="4.0"/>

      <SetMppiParams node="{node}"
                    controller_node="/AT_R2/controller_server"
                    plugin_prefix="FollowPath"
                    goal_angle_weight="5.0"
                    goal_angle_threshold="0.3"
                    vx_max="1.2"
                    vx_min="-1.2"
                    vy_max="1.2"
                    wz_max="4.0"
                    vx_std="0.35"
                    vy_std="0.35"
                    wz_std="0.35"
                    pathalign_use_path_orientations="false"
                    pathalign_threshold="3.0"
                    pathalign_offset_from_furthest="15"
                    goal_x_tolerance="0.03"
                    goal_y_tolerance="0.05"
                    goal_yaw_tolerance="0.05"
                    goal_stable_duration="0.3"
                    wait_after_set="0.2"/>

      <!-- ===== A 段: 预装手上块 (机械臂 hold_block_red + 顶端气泵吸住) ===== -->
      <ArmMoveNamed node="{node}"
                    pose_name="hold_block_red"
                    server_name="robotic_task"
                    task_id="1"
                    duration="5.0"/>
      <PublishPumpCmd node="{node}" command="1" topic="/AT_R2/pump_cmd"/>

      <!-- 一键启动门控 -->
      <WaitForStart node="{node}"
                    prompt="按 Enter 或接受 /AT_R2/red_start_cmd 开始启动"
                    start_topic="/AT_R2/red_start_cmd"
                    start_value="1"
                    enable_topic="true"
                    clear_buffer="true"
                    timeout="0.0"/>

      <!-- 导航进三区入口 -->
      <PublishGoal node="{node}" x="11.5" y="0.7" yaw="0.0" frame_id="map" goal="{goal}"/>

      <!-- 等三区放行信号 -->
      <WaitForStart node="{node}"
                    prompt="按 Enter 或接受 /AT_R2/zone3_cmd 开始放置 KFS"
                    start_topic="/AT_R2/zone3_cmd"
                    start_value="1"
                    enable_topic="true"
                    clear_buffer="true"
                    timeout="0.0"/>

      <SetMppiParams node="{node}"
                    controller_node="/AT_R2/controller_server"
                    plugin_prefix="FollowPath"
                    goal_angle_weight="5.0"
                    goal_angle_threshold="1.0"
                    vx_max="1.2"
                    vx_min="-1.2"
                    vy_max="1.2"
                    wz_max="4.0"
                    vx_std="0.4"
                    vy_std="0.4"
                    wz_std="0.35"
                    pathalign_use_path_orientations="false"
                    pathalign_threshold="3.0"
                    pathalign_offset_from_furthest="15"
                    goal_x_tolerance="0.03"
                    goal_y_tolerance="0.05"
                    goal_yaw_tolerance="0.05"
                    goal_stable_duration="0.3"
                    wait_after_set="0.2"/>

      <!-- 导航到三区内部 + 放置准备位 -->
      <PublishGoal node="{node}"
                   x="10.97"
                   y="2.2"
                   yaw="1.57"
                   frame_id="map"
                   action_name="/AT_R2/navigate_to_pose"
                   goal="{place_goal}"/>

      <!-- 导航到放置准备点(P1) || 摆放置姿态, 两者都必须成功 -->
      <ParallelAll max_failures="1">
        <PublishGoal node="{node}"
                     x="11.07"
                     y="4.0"
                     yaw="1.57"
                     frame_id="map"
                     action_name="/AT_R2/navigate_to_pose"
                     goal="{place_goal}"/>
        <ArmMoveNamed node="{node}"
                      pose_name="place_grid_red_1"
                      server_name="robotic_task"
                      task_id="1"
                      duration="2.0"/>
      </ParallelAll>

      <!-- ================================================================
           B 段: 第一次等格子选择 -> 放【手上块】到所选格子
           (照 v5 case1/2/3 放块流程) -->
      <WaitSlotSelect node="{node}"
                      topic="/AT_R2/place_slot_select"
                      prompt="第一次: 等待放格子选择 (1/2/3=格子)"
                      slot_sel="{slot_sel}"/>

      <SetCostmapInflation node="{node}"
          local_radius="0.25"
          global_radius="0.25"
          local_cost_scaling_factor="1.0"
          global_cost_scaling_factor="4.0"/>
      <PublishGoal node="{node}"
                   x="11.07"
                   y="4.75"
                   yaw="1.57"
                   frame_id="map"
                   action_name="/AT_R2/navigate_to_pose"
                   goal="{place_goal}"/>

      <!-- B1+B2. 摆放置姿态 + 导航到所选 slot -->
      <ParallelAll max_failures="1">
        <Sequence>
          <DelayMs delay_msec="100">
            <AlwaysSuccess/>
          </DelayMs>
          <ArmMoveNamed node="{node}"
                        pose_name="place_grid_red_1"
                        server_name="robotic_task"
                        task_id="1"
                        duration="2.0"/>
        </Sequence>
        <PublishGoal node="{node}"
                     x="{slot_x}"
                     y="{slot_y}"
                     yaw="{slot_yaw}"
                     frame_id="map"
                     action_name="/AT_R2/navigate_to_pose"
                     goal="{place_goal}"/>
      </ParallelAll>

      <!-- B2.5 激光对距精对齐: 已在范围内直接过, 否则伺服对齐
           TODO: target_y / target_distance / distance_topic 为占位值, 按红区放块实测调整。 -->
      <Fallback>
        <GraspReadyByPoseDistance node="{node}"
                                  map_frame="map"
                                  base_frame="base_footprint"
                                  target_y="5.45"
                                  y_tolerance="6.00"
                                  target_yaw="1.57"
                                  yaw_tolerance="1.0"
                                  distance_topic="/AT_R2/distance_grasp"
                                  distance_scale="0.001"
                                  target_distance="{slot_laser_dist}"
                                  distance_tolerance="0.050"
                                  stable_count="3"
                                  max_data_age="0.5"/>

        <DistanceServoAlign node="{node}"
                            distance_topic="/AT_R2/distance_grasp"
                            distance_scale="0.001"
                            target_distance="{slot_laser_dist}"
                            tolerance="0.01"
                            kp="0.8"
                            max_speed="0.2"
                            min_speed="0.015"
                            stable_count="2"
                            max_data_age="0.5"
                            timeout="8.0"
                            publish_rate_hz="50.0"
                            cmd_axis="y"
                            positive_error_direction="1.0"
                            side_speed_scale="0.0"
                            side_speed_direction="-1.0"
                            filter_enable="true"
                            median_window="3"
                            ema_tau="0.1"
                            cmd_vel_topic="/AT_R2/cmd_vel_nav2_result"/>
      </Fallback>

      <!-- B3. 往格子里怼 (顶墙) -->
      <ForceSuccess>
        <DockToWall node="{node}"
                    vy="0.0"
                    vx="0.15"
                    wz="0.0"
                    stall_threshold="0.02"
                    stall_duration="10.0"
                    timeout="5.0"
                    publish_rate_hz="50.0"
                    cmd_vel_topic="/AT_R2/cmd_vel_bt"
                    distance_topic="/AT_R2/distance_head"
                    distance_scale="0.001"
                    distance_stop_below="0.27"
                    odom_topic="/AT_R2/odometry"/>
      </ForceSuccess>

      <!-- B4. 松顶端气泵 放下【手上块】 -->
      <PublishPumpCmd node="{node}" command="0" topic="/AT_R2/pump_cmd"/>
      <DelayMs delay_msec="1000">
        <AlwaysSuccess/>
      </DelayMs>

      <!-- B5. 倒车退出格子 与 收臂 并行 (延时300ms再收臂, 避免倒车瞬间扫到墙) -->
      <ParallelAll max_failures="1">
        <ForceSuccess>
          <DockToWall node="{node}"
                vy="0.0"
                vx="-0.2"
                wz="0.0"
                stall_threshold="0.02"
                stall_duration="10.0"
                timeout="2.0"
                publish_rate_hz="50.0"
                cmd_vel_topic="/AT_R2/cmd_vel_bt"
                odom_topic="/AT_R2/odometry"/>
        </ForceSuccess>
        <ForceSuccess>
          <Sequence>
            <DelayMs delay_msec="300">
              <AlwaysSuccess/>
            </DelayMs>
            <ArmMoveNamed node="{node}"
                  pose_name="place_grid_finish_red"
                  server_name="robotic_task"
                  task_id="1"
                  duration="1.0"/>
          </Sequence>
        </ForceSuccess>
      </ParallelAll>

      <!-- ================================================================
           C 段: 机械臂从底盘取下【底盘块】
           (照 v2 "从车上取" 套动作: 机械臂顶端 pump=1 吸住 -> chassis_pump=0 底盘松开)
           TODO: lift_block/stow_block/place_block 姿态名沿用 v2, 按红区实机确认。 -->
      <ParallelAll max_failures="1">
        <Sequence>
          <ArmMoveNamedAsync pose_name="lift_block" task_id="1" duration="0.8"/>
          <ArmMoveNamedAsync pose_name="stow_block" task_id="1" duration="1.2"/>
          <ArmMoveNamedAsync pose_name="place_block" task_id="1" duration="0.8"/>
          <WaitArmIdle timeout="20.0"/>
          <!-- 机械臂顶端气泵吸住底盘块 -->
          <PublishPumpCmd node="{node}" command="1" topic="/AT_R2/pump_cmd"/>
          <DelayMs delay_msec="500">
            <AlwaysSuccess/>
          </DelayMs>
          <!-- 底盘气泵松开, 把块交给机械臂 -->
          <PublishPumpCmd node="{node}" command="0" topic="/AT_R2/chassis_pump_cmd"/>
          <DelayMs delay_msec="500">
            <AlwaysSuccess/>
          </DelayMs>
          <ArmMoveNamedAsync pose_name="stow_block" task_id="1" duration="0.8"/>
          <ArmMoveNamedAsync pose_name="lift_block" task_id="1" duration="0.8"/>
          <ArmMoveNamedAsync pose_name="place_interim_pos_red" task_id="1" duration="1.5"/>
          <WaitArmIdle timeout="20.0"/>
        </Sequence>
        <!-- 取块动作时同时导航回放置准备位, 为下一次放块做准备 -->
        <PublishGoal node="{node}"
                     x="11.07"
                     y="4.0"
                     yaw="1.57"
                     frame_id="map"
                     action_name="/AT_R2/navigate_to_pose"
                     goal="{place_goal}"/>
      </ParallelAll>

      <!-- ================================================================
           D 段: 第二次等格子选择 -> 1/2/3=放第二层格子; 4=大胜爬三层 -->
      <WaitSlotSelect node="{node}"
                      topic="/AT_R2/place_slot_select"
                      prompt="第二次: 等待选择 (1/2/3=放第二层格子, 4=大胜)"
                      slot_sel="{slot_sel}"/>

      <!-- ===== case 1/2/3: 放【底盘块】到第二层所选格子 (照 v5 case1/2/3) ===== -->
      <Sequence _skipIf="slot_sel == 4">
        <SetCostmapInflation node="{node}"
            local_radius="0.25"
            global_radius="0.25"
            local_cost_scaling_factor="1.0"
            global_cost_scaling_factor="4.0"/>
        <PublishGoal node="{node}"
                     x="11.07"
                     y="4.75"
                     yaw="1.57"
                     frame_id="map"
                     action_name="/AT_R2/navigate_to_pose"
                     goal="{place_goal}"/>

        <!-- 摆放置姿态 + 导航到所选 slot -->
        <ParallelAll max_failures="1">
          <Sequence>
            <DelayMs delay_msec="100">
              <AlwaysSuccess/>
            </DelayMs>
            <ArmMoveNamed node="{node}"
                          pose_name="place_grid_red_1"
                          server_name="robotic_task"
                          task_id="1"
                          duration="2.0"/>
          </Sequence>
          <PublishGoal node="{node}"
                       x="{slot_x}"
                       y="{slot_y}"
                       yaw="{slot_yaw}"
                       frame_id="map"
                       action_name="/AT_R2/navigate_to_pose"
                       goal="{place_goal}"/>
        </ParallelAll>

        <!-- 激光对距精对齐 -->
        <Fallback>
          <GraspReadyByPoseDistance node="{node}"
                                    map_frame="map"
                                    base_frame="base_footprint"
                                    target_y="5.45"
                                    y_tolerance="6.00"
                                    target_yaw="1.57"
                                    yaw_tolerance="1.0"
                                    distance_topic="/AT_R2/distance_grasp"
                                    distance_scale="0.001"
                                    target_distance="{slot_laser_dist}"
                                    distance_tolerance="0.050"
                                    stable_count="3"
                                    max_data_age="0.5"/>

          <DistanceServoAlign node="{node}"
                              distance_topic="/AT_R2/distance_grasp"
                              distance_scale="0.001"
                              target_distance="{slot_laser_dist}"
                              tolerance="0.01"
                              kp="0.8"
                              max_speed="0.2"
                              min_speed="0.015"
                              stable_count="2"
                              max_data_age="0.5"
                              timeout="8.0"
                              publish_rate_hz="50.0"
                              cmd_axis="y"
                              positive_error_direction="1.0"
                              side_speed_scale="0.0"
                              side_speed_direction="-1.0"
                              filter_enable="true"
                              median_window="3"
                              ema_tau="0.1"
                              cmd_vel_topic="/AT_R2/cmd_vel_nav2_result"/>
        </Fallback>

        <!-- 往格子里怼 (顶墙) -->
        <ForceSuccess>
          <DockToWall node="{node}"
                      vy="0.0"
                      vx="0.15"
                      wz="0.0"
                      stall_threshold="0.02"
                      stall_duration="10.0"
                      timeout="5.0"
                      publish_rate_hz="50.0"
                      cmd_vel_topic="/AT_R2/cmd_vel_bt"
                      distance_topic="/AT_R2/distance_head"
                      distance_scale="0.001"
                      distance_stop_below="0.27"
                      odom_topic="/AT_R2/odometry"/>
        </ForceSuccess>

        <!-- 松顶端气泵 放下块 -->
        <PublishPumpCmd node="{node}" command="0" topic="/AT_R2/pump_cmd"/>
        <DelayMs delay_msec="1000">
          <AlwaysSuccess/>
        </DelayMs>

        <!-- 倒车退出格子 与 收臂 并行 -->
        <ParallelAll max_failures="1">
          <ForceSuccess>
            <DockToWall node="{node}"
                  vy="0.0"
                  vx="-0.2"
                  wz="0.0"
                  stall_threshold="0.02"
                  stall_duration="10.0"
                  timeout="2.0"
                  publish_rate_hz="50.0"
                  cmd_vel_topic="/AT_R2/cmd_vel_bt"
                  odom_topic="/AT_R2/odometry"/>
          </ForceSuccess>
          <ForceSuccess>
            <Sequence>
              <DelayMs delay_msec="300">
                <AlwaysSuccess/>
              </DelayMs>
              <ArmMoveNamed node="{node}"
                    pose_name="place_grid_finish_red"
                    server_name="robotic_task"
                    task_id="1"
                    duration="1.0"/>
            </Sequence>
          </ForceSuccess>
        </ParallelAll>

        <!-- 放完回起始点结束 -->
        <PublishGoal node="{node}"
                     x="11.5"
                     y="0.7"
                     yaw="1.57"
                     frame_id="map"
                     action_name="/AT_R2/navigate_to_pose"
                     goal="{place_goal}"/>
      </Sequence>

      <!-- ===== case 4: 大胜爬三层, 结束比赛 (照 v5 case4) ===== -->
      <Sequence _skipIf="slot_sel != 4">
        <ArmMoveNamed node="{node}"
                        pose_name="three_layer_arm_1_red"
                        server_name="robotic_task"
                        task_id="1"
                        duration="2.0"/>
        <!-- 到大胜准备位 (导航 || 摆臂, 两者都必须成功) -->
        <ParallelAll max_failures="1">
          <PublishGoal node="{node}"
                       x="10.7"
                       y="4.85"
                       yaw="0.0"
                       frame_id="map"
                       action_name="/AT_R2/navigate_to_pose"
                       goal="{place_goal}"/>
          <ArmMoveNamed node="{node}"
                        pose_name="three_layer_arm_2_red"
                        server_name="robotic_task"
                        task_id="1"
                        duration="2.0"/>
        </ParallelAll>

        <!-- 发 lift command=1 (发指令 || 摆臂, 两者都必须成功) -->
        <ParallelAll max_failures="1">
          <Sequence>
            <DelayMs delay_msec="1000">
              <AlwaysSuccess/>
            </DelayMs>
            <PublishLiftCmd node="{node}" command="1"/>
          </Sequence>
          <ArmMoveNamed node="{node}"
                        pose_name="three_layer_arm_2_red"
                        server_name="robotic_task"
                        task_id="1"
                        duration="2.0"/>
        </ParallelAll>
        <!-- 按回车或等话题: 降下底盘 -->
        <WaitForStart node="{node}"
                      prompt="大胜: 按 Enter 或发布 /AT_R2/zone3_cmd 继续 (抬腿)"
                      start_topic="/AT_R2/zone3_cmd"
                      start_value="1"
                      enable_topic="true"
                      clear_buffer="true"
                      timeout="0.0"/>
        <PublishLiftCmd node="{node}" command="2"/>
        <DelayMs delay_msec="1000">
          <AlwaysSuccess/>
        </DelayMs>
        <!-- 发 lift command=3 (发指令 || 摆臂, 两者都必须成功) -->
        <ParallelAll max_failures="1">
          <Sequence>
            <DelayMs delay_msec="1000">
              <AlwaysSuccess/>
            </DelayMs>
            <PublishLiftCmd node="{node}" command="3"/>
          </Sequence>
          <ArmMoveNamed node="{node}"
                        pose_name="three_layer_arm_3_red"
                        server_name="robotic_task"
                        task_id="1"
                        duration="2.0"/>
        </ParallelAll>
        <DelayMs delay_msec="2000">
          <AlwaysSuccess/>
        </DelayMs>
        <!-- 按回车或等话题: 放块 -->
        <WaitForStart node="{node}"
                      prompt="大胜: 按 Enter 或发布 /AT_R2/meilin_mission_start 放块"
                      start_topic="/AT_R2/meilin_mission_start"
                      start_value="1"
                      enable_topic="true"
                      clear_buffer="true"
                      timeout="0.0"/>

        <PublishPumpCmd node="{node}" command="0" topic="/AT_R2/pump_cmd"/>
        <DelayMs delay_msec="1000">
          <AlwaysSuccess/>
        </DelayMs>
      </Sequence>

    </Sequence>
  </BehaviorTree>
</root>
