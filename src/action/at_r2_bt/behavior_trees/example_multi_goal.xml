<?xml version="1.0"?>
<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <Sequence name="MultiGoalPatrol">
      <!-- First goal -->
       <PublishGoal node="{node}" x="1.0" y="1.0" yaw="0.0" frame_id="map" goal="{goal}"/>
      <!-- Second goal -->
       <PublishGoal node="{node}" x="1.0" y="4.0" yaw="0.0" frame_id="map" goal="{goal}"/>

      
      <!-- Third goal -->
       <PublishGoal node="{node}" x="3.0" y="2.0" yaw="0.0" frame_id="map" goal="{goal}"/>

      
      <!-- Return to start -->
       <PublishGoal node="{node}" x="2.0" y="5.0" yaw="0.0" frame_id="map" goal="{goal}"/>

    </Sequence>
  </BehaviorTree>
</root>
