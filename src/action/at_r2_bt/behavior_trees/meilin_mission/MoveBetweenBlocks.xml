<?xml version="1.0"?>
<root BTCPP_format="4">

  <!-- ================== MOVE 子树（async 流水线版）==================
       臂动作通过 ArmJobRunner 后台串行队列执行。
       BT 的"臂腿"只负责把动作 enqueue 进去后立即返回，所以底盘腿不再被臂腿拖。
         A 段末尾 WaitArmIdle：硬安全栅栏 (PICK 早期 lift→stow→place→关泵 必须落定再上楼梯)
         B/C 末尾不再栅栏：臂动作在背景里跑，PICK/PUSH 子树入口处的 WaitArmIdle 接住
       早/晚期切分依据：
         PICK1 早期=lift→stow→place→关泵(放稳前不能爬梯)，晚期=等真空泄气→stow→lift→ready
         PICK2 早期=lift(臂离地后再爬梯)，晚期=hold_block
         PUSH  早期=hold→push_finish→关泵，晚期=ready -->
  <BehaviorTree ID="MoveBetweenBlocks">
    <Sequence>
      <!-- ===== 段 A：到当前 prep || 收尾早期 ===== -->
      <ParallelAll max_failures="1">
        <Fallback>
          <Sequence>
            <ScriptCondition code="need_finish == 0"/>
            <IsPrepSkippable node="{node}"
                             target_x="{prep_x}" target_y="{prep_y}" target_yaw="{prep_yaw}"
                             x_tolerance="0.15" y_tolerance="0.15" yaw_tolerance="0.1"/>
          </Sequence>
          <PublishGoal node="{node}"
                       x="{prep_x}" y="{prep_y}" yaw="{prep_yaw}"
                       frame_id="map" goal="{nav_goal}"/>
        </Fallback>
        <ForceSuccess>
          <Switch3 variable="{need_finish}" case_1="1" case_2="2" case_3="0">
            <Switch2 variable="{pick_count}" case_1="1" case_2="2">
              <Sequence>
                <PublishHeadCmd node="{node}" command="10"
                        topic="/AT_R2/head_gripper_cmd"
                        wait_done="false"/>
                <ArmMoveNamedAsync pose_name="lift_block"  task_id="1" duration="-1.0"/>
                <ArmMoveNamedAsync pose_name="stow_block"  task_id="1" duration="1.2"/>
                <ArmMoveNamedAsync pose_name="place_block" task_id="1" duration="0.8"/>
                <WaitArmIdle timeout="20.0"/>
                <PublishPumpCmd node="{node}" command="0"/>
              </Sequence>
              <Sequence>
                <ArmMoveNamedAsync pose_name="lift_block2" task_id="1" duration="-1.0"/>
                <ArmMoveNamedAsync pose_name="stow_block2" task_id="1" duration="1.2"/>
                <ArmMoveNamedAsync pose_name="place_block2" task_id="1" duration="1.0"/>
              </Sequence>
              <ArmMoveNamedAsync pose_name="lift_block" task_id="1" duration="1.5"/>
            </Switch2>
            <Sequence>
              <ArmMoveNamedAsync pose_name="hold_block"   task_id="1" duration="1.5"/>
              <WaitArmIdle timeout="20.0"/>
              <ArmMoveNamedAsync pose_name="push_finish"  task_id="1" duration="1.5"/>
            </Sequence>
            <AlwaysSuccess/>
            <AlwaysSuccess/>
          </Switch3>
        </ForceSuccess>
      </ParallelAll>
      <!-- 安全栅栏：lift 等抬升类动作必须完成再上楼梯，避免抬升过程中翻车 -->
      <WaitArmIdle timeout="20.0"/>

      <!-- ===== 段 B：楼梯（不再等臂）|| 把"晚期"塞进臂队列 ===== -->
      <ParallelAll max_failures="1">
        <Switch2 variable="{stair_dir}" case_1="UP" case_2="DOWN">
          <!-- 上下台阶期间用"台阶前的准备朝向 {prep_yaw}"做角度纠偏（只发 angular.z）。
               yaw_correct_enable=false 即可关闭；其余为可调参数。 -->
          <ClimbStair   node="{node}" height="{abs_dh}"
                        yaw_correct_enable="false"
                        target_yaw="{prep_yaw}"
                        yaw_kp="1.5"
                        yaw_wz_max="0.4"
                        yaw_engage_threshold="0.1"
                        yaw_deadband="0.02"
                        yaw_cmd_topic="/AT_R2/cmd_vel_bt"/>
          <DescendStair node="{node}" height="{abs_dh}"
                        yaw_correct_enable="false"
                        target_yaw="{prep_yaw}"
                        yaw_kp="1.5"
                        yaw_wz_max="0.4"
                        yaw_engage_threshold="0.1"
                        yaw_deadband="0.02"
                        yaw_cmd_topic="/AT_R2/cmd_vel_bt"/>
          <AlwaysSuccess/>
        </Switch2>
        <ForceSuccess>
          <Switch3 variable="{need_finish}" case_1="1" case_2="2" case_3="0">
            <Switch2 variable="{pick_count}" case_1="1" case_2="2">
              <Sequence>
                <!-- <WaitArmIdle timeout="20.0"/> -->
                <DelayMs delay_msec="900"><AlwaysSuccess/></DelayMs>
                <ArmMoveNamedAsync pose_name="stow_block" task_id="1" duration="0.8"/>
                <ArmMoveNamedAsync pose_name="lift_block" task_id="1" duration="0.8"/>
                <ArmMoveNamedAsync pose_name="ready"      task_id="1" duration="0.8"/>
              </Sequence>
              <ArmMoveNamedAsync pose_name="place_block2" task_id="1" duration="1.0"/>
              <ArmMoveNamedAsync pose_name="ready" task_id="1" duration="1.5"/>
            </Switch2>
            <Sequence>
              <WaitArmIdle timeout="20.0"/>
              <PublishPumpCmd node="{node}" command="0"/>
              <ArmMoveNamedAsync pose_name="ready" task_id="1" duration="3.0"/>
            </Sequence>  
            <AlwaysSuccess/>
            <AlwaysSuccess/>
          </Switch3>
        </ForceSuccess>
      </ParallelAll>

      <!-- ===== 段 C：到下一 prep || 把下一次 PICK 的臂 prep 塞进队列 =====
           PICK 时先调一次 SelectArmPrepName 取出名字和 arm_prep_is_low:
             - is_low=1 (down200/down400 低姿态): 必须先走完再下臂, 否则臂会蹭地
             - is_low=0 (up200/up400/平位): 与导航并行下臂
           PUSH 时只导航不动臂。 -->
      <Switch3 variable="{next_step_type}" case_1="PICK" case_2="PUSH" case_3="__never__">
        <!-- ===== PICK: 选名 → 按 is_low 串/并行 ===== -->
        <Sequence>
          <ForceSuccess>
            <SelectArmPrepName next_from_id="{next_from_id}"
                               next_target_id="{next_target_id}"
                               from_x_override="{next_prep_x}"
                               from_y_override="{next_prep_y}"
                               from_yaw_override="{next_prep_yaw}"
                               arm_prep_name="{arm_prep_name}"
                               arm_prep_is_low="{arm_prep_is_low}"
                               block_yaml="{block_yaml}"/>
          </ForceSuccess>
          <Fallback>
            <!-- 低姿态 prep: 串行 — 先到 prep 再下臂 -->
            <Sequence>
              <ScriptCondition code="arm_prep_is_low == 1"/>
              <Fallback>
                <IsPrepSkippable node="{node}"
                                 target_x="{next_prep_x}" target_y="{next_prep_y}" target_yaw="{next_prep_yaw}"
                                 x_tolerance="0.05" y_tolerance="0.05" yaw_tolerance="0.1"/>
                <PublishGoal node="{node}"
                             x="{next_prep_x}" y="{next_prep_y}" yaw="{next_prep_yaw}"
                             frame_id="map" goal="{nav_goal}"/>
              </Fallback>
              <ForceSuccess>
                <Sequence>
                  <ArmMoveNamedAsync pose_name="{arm_prep_name}" task_id="1" duration="1.5"/>
                  <Script code="arm_prep_queued := 1"/>
                </Sequence>
              </ForceSuccess>
            </Sequence>
            <!-- 高/平位 prep: 与导航并行 -->
            <ParallelAll max_failures="1">
              <Fallback>
                <IsPrepSkippable node="{node}"
                                 target_x="{next_prep_x}" target_y="{next_prep_y}" target_yaw="{next_prep_yaw}"
                                 x_tolerance="0.05" y_tolerance="0.05" yaw_tolerance="0.1"/>
                <PublishGoal node="{node}"
                             x="{next_prep_x}" y="{next_prep_y}" yaw="{next_prep_yaw}"
                             frame_id="map" goal="{nav_goal}"/>
              </Fallback>
              <ForceSuccess>
                <Sequence>
                  <ArmMoveNamedAsync pose_name="{arm_prep_name}" task_id="1" duration="1.0"/>
                  <Script code="arm_prep_queued := 1"/>
                </Sequence>
              </ForceSuccess>
            </ParallelAll>
          </Fallback>
        </Sequence>
        <!-- ===== PUSH: 只导航 ===== -->
        <Fallback>
          <IsPrepSkippable node="{node}"
                           target_x="{next_prep_x}" target_y="{next_prep_y}" target_yaw="{next_prep_yaw}"
                           x_tolerance="0.05" y_tolerance="0.05" yaw_tolerance="0.1"/>
          <PublishGoal node="{node}"
                       x="{next_prep_x}" y="{next_prep_y}" yaw="{next_prep_yaw}"
                       frame_id="map" goal="{nav_goal}"/>
        </Fallback>
        <!-- ===== never / default: 不做事 ===== -->
        <AlwaysSuccess/>
        <AlwaysSuccess/>
      </Switch3>

      <Script code="need_finish := 0"/>
    </Sequence>
  </BehaviorTree>

</root>
