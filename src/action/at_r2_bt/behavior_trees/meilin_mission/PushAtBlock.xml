<?xml version="1.0"?>
<root BTCPP_format="4">

  <!-- ================== PUSH 子树 ================== -->
  <BehaviorTree ID="PushAtBlock">
    <Sequence>
      <!-- 等上一段 MOVE 后台跑的臂动作落定，再开 PUSH 的 ArmTask -->
      <WaitArmIdle timeout="20.0"/>

      <!-- PublishGoal 已移到上一步 MOVE 上完台阶后按 next_step_type==PUSH 条件下发 -->
      <PreSteerAlign node="{node}" vx="0.1" duration="0.1" publish_rate_hz="50"/>
      <ArmTask node="{node}"
               task_id="3"
               server_name="robotic_task"
               base_frame="base_footprint"
               target_frame="target_object"
               map_frame="map"
               tf_timeout="5.0"
               cube_x="{cube_x}"
               cube_y="{cube_y}"
               block_height="{block_h}"
               grasp_height="0.0"
               goal_data="{arm_goal_data}"
               err_code="{arm_err_code}"
               reason="{arm_reason}"/>

      <!-- 推完成功，标记下一个 MOVE 跑 PUSH 收尾(=2，区别于 PICK 的 1) -->
      <Script code="need_finish := 2"/>
    </Sequence>
  </BehaviorTree>

</root>
