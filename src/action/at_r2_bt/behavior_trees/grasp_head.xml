<?xml version="1.0"?>
<root BTCPP_format="4" main_tree_to_execute="GraspHead">

  <!-- ================== 抓取武器头 + 对接主树 ==================
       这套独立的"武器头爪子"通过话题 /AT_R2/head_gripper_cmd (Int32) 驱动:
         1 = 准备抓取   2 = 抓取   3 = 抬起武器头   4 = 对接
       流程:
         0. 切换到一区模式 (SetZoneMode mode=1) —— 否则串口节点门控会忽略抓取命令
         1. 通知爪子"准备抓取" (head cmd=1)
         2. 调参 + 导航到柜台前预备点 (PublishGoal)
         3. 侧向 + 贴靠柜台 (DockToWall)
         4. 通知爪子"抓取" (head cmd=2)
         5. 通知爪子"抬起武器头" (head cmd=3)
         6. 后退离开柜台 (DockToWall vx 负向)
         7. 导航到与持杆机器人对接的位置 (PublishGoal)
         8. 通知爪子"对接" (head cmd=4)

  -->
  <BehaviorTree ID="GraspHead">
    <Sequence>

      <SetZoneMode node="{node}" mode="1" topic="/AT_R2/zone_mode"/>

      <SetCostmapInflation node="{node}"
                    local_radius="0.05"
                    global_radius="0.15"
                    local_cost_scaling_factor="5.0"
                    global_cost_scaling_factor="5.0"/>
      <SetMppiParams node="{node}"
               controller_node="/AT_R2/controller_server"
               plugin_prefix="FollowPath"
               goal_angle_weight="6.0"
               goal_angle_threshold="2.0"
               vx_max="1.2"
               vx_min="-1.2"
               vy_max="1.2"
               wz_max="4.0"
               vx_std="0.4"
               vy_std="0.4"
               wz_std="0.4"
               goal_x_tolerance="0.03"
               goal_y_tolerance="0.05"
               goal_yaw_tolerance="0.05"
               goal_stable_duration="0.3"
               wait_after_set="0.2"/>

      <!-- 一键启动门控: 参数已提前设置完成后停在这里，比赛开始时按 Enter 立即开始导航。 -->
      <!-- require_tty="false": ros2 launch 下无 TTY 时自动跳过, ros2 run 直接从终端启动时仍会等待 Enter。 -->
      <WaitForEnter node="{node}"
                    prompt="参数已设置完成，按 Enter 开始导航"
                    require_tty="false"
                    clear_buffer="true"
                    timeout="0.0"/>

      <ParallelAll max_failures="1">
        <!-- 1腿 -->
          <PublishGoal node="{node}"
                  x="{grasp_prep_x}" y="{grasp_prep_y}" yaw="{grasp_prep_yaw}"
                  frame_id="map"
                  goal="{nav_goal}"/>
                  
        <!-- 2 -->
        <Sequence>
          <DelayMs delay_msec="400">
            <AlwaysSuccess/>
          </DelayMs>  
          <PublishHeadCmd node="{node}" command="1"
                          topic="/AT_R2/head_gripper_cmd"
                          wait_done="false"/>
        </Sequence>
      </ParallelAll>         
      <!-- <PublishGoal node="{node}"
                x="1.0" y="5.50" yaw="-3.14"
                frame_id="map"
                goal="{nav_goal}"/> -->
      <!-- Step 1: 通知爪子准备抓取(可与导航并行执行, 这里先发指令再走) -->

      <!-- <DelayMs delay_msec="3000">
        <AlwaysSuccess/>
      </DelayMs> -->
      <!-- Step 2: 调参 + 导航到柜台前预备点 -->

      <!-- Step 3: 侧向贴靠柜台
           vy > 0 向左贴, vy < 0 向右贴, 根据柜台方向调整
           stall_threshold: 位移阈值, stall_duration: 连续被挡确认时间 -->
      <ForceSuccess>
        <DockToWall node="{node}"
                    vy="-0.2"
                    vx="0.0"
                    wz="0.0"
                    stall_threshold="0.02"
                    stall_duration="0.4"
                    timeout="1.0"
                    publish_rate_hz="50.0"
                    cmd_vel_topic="/AT_R2/cmd_vel_bt"
                    odom_topic="/AT_R2/odometry"/>
      </ForceSuccess>

      <!-- 前向贴靠柜台 -->
      <!-- <DockToWall node="{node}"
                  vy="0.0"
                  vx="0.1"
                  wz="0.0"
                  stall_threshold="0.03"
                  stall_duration="0.5"
                  timeout="2.0"
                  publish_rate_hz="50.0"
                  cmd_vel_topic="/AT_R2/cmd_vel_bt"
                  odom_topic="/AT_R2/odometry"/> -->
      <Fallback>
        <GraspReadyByPoseDistance node="{node}"
                                  map_frame="map"
                                  base_frame="base_link"
                                  target_y="{grasp_prep_y}"
                                  y_tolerance="{grasp_prep_y_tolerance}"
                                  target_yaw="{grasp_prep_yaw}"
                                  yaw_tolerance="{grasp_prep_yaw_tolerance}"
                                  distance_topic="/AT_R2/distance"
                                  distance_scale="0.001"
                                  target_distance="{grasp_laser_target_distance}"
                                  distance_tolerance="0.01"
                                  stable_count="3"
                                  max_data_age="0.5"/>

        <DistanceServoAlign node="{node}"
                            distance_topic="/AT_R2/distance"
                            distance_scale="0.001"
                            target_distance="{grasp_laser_target_distance}"
                            tolerance="0.01"
                            kp="0.5"
                            max_speed="0.1"
                            min_speed="0.015"
                            stable_count="5"
                            max_data_age="0.5"
                            timeout="8.0"
                            publish_rate_hz="50.0"
                            cmd_axis="x"
                            positive_error_direction="-1.0"
                            side_speed_scale="0.6"
                            side_speed_direction="-1.0"
                            cmd_vel_topic="/AT_R2/cmd_vel_nav2_result"/>
      </Fallback>
      <!-- Step 4: 通知爪子抓取, 并留出抓取执行时间
           若爪子有完成反馈, 改成: wait_done="true" timeout="10.0" 并删掉下面的 DelayMs -->
      <PublishHeadCmd node="{node}" command="2"
                      topic="/AT_R2/head_gripper_cmd"
                      wait_done="false"/>
      <DelayMs delay_msec="500">
        <AlwaysSuccess/>
      </DelayMs>
      <PublishHeadCmd node="{node}" command="3"
                      topic="/AT_R2/head_gripper_cmd"
                      wait_done="false"/>
      <DelayMs delay_msec="2000">
        <AlwaysSuccess/>
      </DelayMs>

      <!-- Step 5: 通知爪子抬起武器头, 留出抬起执行时间
           抬起后再后退, 避免武器头还在柜台上就拖动 -->
      <ForceSuccess>
        <PublishHeadCmd node="{node}" command="4"
                        topic="/AT_R2/head_gripper_cmd"
                        wait_done="false"
                        timeout="1.0"/>
      </ForceSuccess>

      <!-- Step 6: 抬起完成后向后退离开柜台 (vx 负向)
           timeout 内退够距离即可, 这里用一个略大的位移阈值 -->
      <ParallelAll max_failures="1">
        <ForceSuccess>      
          <DockToWall node="{node}"
                      vy="0.35"
                      vx="0.0"
                      wz="0.0"
                      stall_threshold="0.30"
                      stall_duration="10.0"
                      timeout="1.0"
                      publish_rate_hz="50.0"
                      cmd_vel_topic="/AT_R2/cmd_vel_bt"
                      odom_topic="/AT_R2/odometry"/>
        </ForceSuccess>
        <PublishHeadCmd node="{node}" command="5"
                topic="/AT_R2/head_gripper_cmd"
                wait_done="false"/>
      </ParallelAll>       

      <!-- Step 7: 导航到与持杆机器人对接的位置
           TODO: 把对接点坐标 (x, y, yaw) 改成实际值 -->
      <!-- <SetMppiParams node="{node}"
               controller_node="/AT_R2/controller_server"
               plugin_prefix="FollowPath"
               goal_angle_weight="6.0"
               goal_angle_threshold="2.0"
               vx_max="1.2"
               vx_min="-1.2"
               vy_max="1.2"
               wz_max="4.0"
               vx_std="0.35"
               vy_std="0.35"
               wz_std="0.35"
               goal_x_tolerance="0.05"
               goal_y_tolerance="0.05"
               goal_yaw_tolerance="0.10"
               wait_after_set="0.3"/> -->

      <ParallelAll max_failures="1">
        <!-- 1腿 -->
        <PublishGoal node="{node}"
                  x="0.47" y="5.1" yaw="0.0"
                  frame_id="map"
                  goal="{nav_goal}"/>

        <!-- 2 -->
        <Sequence>
          <DelayMs delay_msec="500">
            <AlwaysSuccess/>
          </DelayMs>  
          <PublishHeadCmd node="{node}" command="6"
                          topic="/AT_R2/head_gripper_cmd"
                          wait_done="false"/>
        </Sequence>
      </ParallelAll>       

      <!-- <SetMppiParams node="{node}"
               controller_node="/AT_R2/controller_server"
               goal_x_tolerance="0.05"
               goal_y_tolerance="0.05"
               goal_yaw_tolerance="0.10"
               wait_after_set="0.3"
               goal_stable_duration="0.1"/>   -->

      <!-- <PublishGoal node="{node}"
                  x="0.40" y="5.1" yaw="0.0"
                  frame_id="map"
                  goal="{nav_goal}"/> -->

      <!-- <ForceSuccess>      
        <DockToWall node="{node}"
                    vy="0.0"
                    vx="-0.2"
                    wz="0.0"
                    stall_threshold="0.03"
                    stall_duration="1.0"
                    timeout="6"
                    publish_rate_hz="50.0"
                    cmd_vel_topic="/AT_R2/cmd_vel_bt"
                    odom_topic="/AT_R2/odometry"/>
      </ForceSuccess> -->
      <!-- <ForceSuccess>      
        <DockToWall node="{node}"
                    vy="0.0"
                    vx="-0.2"
                    wz="0.0"
                    stall_threshold="0.03"
                    stall_duration="0.6"
                    timeout="4"
                    publish_rate_hz="50.0"
                    cmd_vel_topic="/AT_R2/cmd_vel_bt"
                    odom_topic="/AT_R2/odometry"/>
      </ForceSuccess> -->
      <!-- <WaitDockingRelease node="{node}"
                          status_topic="/AT_R2/docking_status"
                          gripper_topic="/AT_R2/head_gripper_cmd"
                          target_status="1"
                          release_cmd="7"
                          timeout="1000.0"/> -->

    </Sequence>
  </BehaviorTree>

</root>
