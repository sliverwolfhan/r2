<?xml version="1.0"?>
<root BTCPP_format="4" main_tree_to_execute="GraspHead">

  <!-- ================== 抓取武器头 + 对接主树 ==================
       这套独立的"武器头爪子"通过话题 /AT_R2/head_gripper_cmd (Int32) 驱动:
         1 = 准备抓取   2 = 抓取   3 = 抬起武器头   4 = 对接
       流程:
         0. 切换到一区模式 (SetZoneMode mode=1) —— 否则串口节点门控会忽略抓取命令
         1. 通知爪子"准备抓取" (head cmd=1)
         2. 调参 + 导航到柜台前预备点 (PublishGoal)
         3. 侧向 + 前向贴靠柜台 (DockToWall)
         4. 通知爪子"抓取" (head cmd=2)
         5. 通知爪子"抬起武器头" (head cmd=3)
         6. 后退离开柜台 (DockToWall vx 负向)
         7. 导航到与持杆机器人对接的位置 (PublishGoal)
         8. 通知爪子"对接" (head cmd=4)

       说明:
       - SetZoneMode 发布到 /AT_R2/zone_mode (Int32, latched), 1=一区/2=二区/3=三区。
         虚拟串口节点据此判断: mode=1 才接受抓取命令, mode=2 才接受爬楼梯命令。
       - PublishHeadCmd 默认 wait_done=false, 发完指令立即返回, 用其后的
         导航/贴靠/DelayMs 留出执行时间。
       - 若爪子节点会在 /AT_R2/head_gripper_done 上回发完成编号, 可将对应
         步骤改为 wait_done="true" timeout="N" 实现真正的同步等待。
  -->
  <BehaviorTree ID="GraspHead">
    <Sequence>

      <!-- Step 0: 切换到一区模式 (mode=1)
           必须最先执行: 虚拟串口节点有 mode 门控, 只有 mode=1 时
           /AT_R2/head_gripper_cmd 的抓取命令才会被采纳并下发给下位机。
           SetZoneMode 是同步节点, 发布即返回成功; 话题 latched, 持续生效。 -->
      <SetZoneMode node="{node}" mode="1" topic="/AT_R2/zone_mode"/>

      <SetCostmapInflation node="{node}"
                    local_radius="0.05"
                    global_radius="0.15"
                    local_cost_scaling_factor="5.0"
                    global_cost_scaling_factor="5.0"/>
      <SetMppiParams node="{node}"
               controller_node="/AT_R2/controller_server"
               plugin_prefix="FollowPath"
               goal_angle_weight="10.0"
               goal_angle_threshold="2.0"
               vx_max="0.7"
               vx_min="-0.7"
               vy_max="0.7"
               wz_max="4.0"
               vx_std="0.3"
               vy_std="0.3"
               wz_std="0.4"
               wait_after_set="0.3"/>
      <PublishGoal node="{node}"
                x="0.89" y="5.50" yaw="-3.12"
                frame_id="map"
                goal="{nav_goal}"/>
      <!-- Step 1: 通知爪子准备抓取(可与导航并行执行, 这里先发指令再走) -->
      <PublishHeadCmd node="{node}" command="1"
                      topic="/AT_R2/head_gripper_cmd"
                      wait_done="false"/>
      <!-- <DelayMs delay_msec="3000">
        <AlwaysSuccess/>
      </DelayMs> -->
      <!-- Step 2: 调参 + 导航到柜台前预备点 -->


      <!-- Step 3: 侧向贴靠柜台
           vy > 0 向左贴, vy < 0 向右贴, 根据柜台方向调整
           stall_threshold: 位移阈值, stall_duration: 连续被挡确认时间 -->
      <ForceSuccess>
        <DockToWall node="{node}"
                    vy="-0.1"
                    vx="0.0"
                    wz="0.0"
                    stall_threshold="0.01"
                    stall_duration="0.5"
                    timeout="3.0"
                    publish_rate_hz="50.0"
                    cmd_vel_topic="/AT_R2/cmd_vel_nav2_result"
                    odom_topic="/AT_R2/odometry"/>
      </ForceSuccess>

      <!-- 前向贴靠柜台 -->
      <!-- <DockToWall node="{node}"
                  vy="0.0"
                  vx="0.1"
                  wz="0.0"
                  stall_threshold="0.03"
                  stall_duration="0.5"
                  timeout="2.0"
                  publish_rate_hz="50.0"
                  cmd_vel_topic="/AT_R2/cmd_vel_nav2_result"
                  odom_topic="/AT_R2/odometry"/> -->

      <!-- Step 4: 通知爪子抓取, 并留出抓取执行时间
           若爪子有完成反馈, 改成: wait_done="true" timeout="10.0" 并删掉下面的 DelayMs -->
      <PublishHeadCmd node="{node}" command="2"
                      topic="/AT_R2/head_gripper_cmd"
                      wait_done="false"/>
      <DelayMs delay_msec="2000">
        <AlwaysSuccess/>
      </DelayMs>

      <!-- Step 5: 通知爪子抬起武器头, 留出抬起执行时间
           抬起后再后退, 避免武器头还在柜台上就拖动 -->
      <PublishHeadCmd node="{node}" command="3"
                      topic="/AT_R2/head_gripper_cmd"
                      wait_done="false"/>
      <!-- <DelayMs delay_msec="2000">
        <AlwaysSuccess/>
      </DelayMs> -->

      <!-- Step 6: 抬起完成后向后退离开柜台 (vx 负向)
           timeout 内退够距离即可, 这里用一个略大的位移阈值 -->
      <ForceSuccess>      
        <DockToWall node="{node}"
                    vy="0.2"
                    vx="0.0"
                    wz="0.0"
                    stall_threshold="0.30"
                    stall_duration="10.0"
                    timeout="2"
                    publish_rate_hz="50.0"
                    cmd_vel_topic="/AT_R2/cmd_vel_nav2_result"
                    odom_topic="/AT_R2/odometry"/>
      </ForceSuccess>
      
      <PublishHeadCmd node="{node}" command="4"
                      topic="/AT_R2/head_gripper_cmd"
                      wait_done="false"/>
      <!-- <DelayMs delay_msec="3000">
        <AlwaysSuccess/>
      </DelayMs> -->
      <!-- Step 7: 导航到与持杆机器人对接的位置
           TODO: 把对接点坐标 (x, y, yaw) 改成实际值 -->
      <!-- <SetCostmapInflation node="{node}"
                    local_radius="0.30"
                    global_radius="0.30"
                    local_cost_scaling_factor="1.0"
                    global_cost_scaling_factor="4.0"/> -->
      <PublishGoal node="{node}"
                x="0.5" y="5.3" yaw="0.0"
                frame_id="map"
                goal="{nav_goal}"/>
      <PublishGoal node="{node}"
                x="0.4" y="5.5" yaw="0.0"
                frame_id="map"
                goal="{nav_goal}"/>
      <ForceSuccess>      
        <DockToWall node="{node}"
                    vy="0.0"
                    vx="-0.2"
                    wz="0.0"
                    stall_threshold="0.05"
                    stall_duration="0.5"
                    timeout="4"
                    publish_rate_hz="50.0"
                    cmd_vel_topic="/AT_R2/cmd_vel_nav2_result"
                    odom_topic="/AT_R2/odometry"/>
      </ForceSuccess>
      <ForceSuccess>      
        <DockToWall node="{node}"
                    vy="0.1"
                    vx="-0.0"
                    wz="0.0"
                    stall_threshold="0.01"
                    stall_duration="0.5"
                    timeout="4"
                    publish_rate_hz="50.0"
                    cmd_vel_topic="/AT_R2/cmd_vel_nav2_result"
                    odom_topic="/AT_R2/odometry"/>
      </ForceSuccess>
      <!-- Step 8: 通知爪子执行对接
           对接通常需要等做完, 这里默认仍用 wait_done=false + DelayMs;
           若有完成反馈建议改 wait_done="true" timeout="15.0" -->


    </Sequence>
  </BehaviorTree>

</root>
