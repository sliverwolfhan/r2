<?xml version="1.0"?>
<root BTCPP_format="4" main_tree_to_execute="GraspHead">

  <!-- ================== 抓取主树 ==================
       流程：
       1. 导航到柜台前方预备点
       2. 机械臂移动到准备位姿
       3. 侧向贴靠柜台 (DockToWall)
       4. 机械臂执行抓取
       5. 机械臂收回
  -->
  <BehaviorTree ID="GraspHead">
    <Sequence>

    <SetCostmapInflation node="{node}"
                    local_radius="0.05"
                    global_radius="0.15"
                    local_cost_scaling_factor="5.0"
                    global_cost_scaling_factor="5.0"/>
      <!-- Step 1: 导航到柜台附近的预备点 -->
      <PublishGoal node="{node}"
                   x="1.3" y="-5.38" yaw="3.12"
                   frame_id="map"
                   goal="{nav_goal}"/>

      <!-- Step 3: 侧向贴靠柜台
           vy > 0 表示向左贴，vy < 0 表示向右贴，根据柜台方向调整
           stall_threshold: 100ms内位移小于5mm认为被挡住
           stall_duration: 连续被挡0.5秒确认贴住 -->
      <DockToWall node="{node}"
                  vy="0.1"
                  vx="0.0"
                  wz="0.0"
                  stall_threshold="0.008"
                  stall_duration="0.5"
                  timeout="3.0"
                  publish_rate_hz="50.0"
                  cmd_vel_topic="/AT_R2/cmd_vel_nav2_result"
                  odom_topic="/AT_R2/odometry"/>

      <!-- <DockToWall node="{node}"
                  vy="0.0"
                  vx="0.1"
                  wz="0.0"
                  stall_threshold="0.03"
                  stall_duration="0.08"
                  timeout="2.0"
                  publish_rate_hz="50.0"
                  cmd_vel_topic="/AT_R2/cmd_vel_nav2_result"
                  odom_topic="/AT_R2/odometry"/> -->
    </Sequence>
  </BehaviorTree>

</root>
