      /> -->
      <ArmTask node="{node}"
            task_id="2"
            server_name="robotic_task"
            base_frame="base_link"
            target_frame="target_object"
            map_frame="map"
            tf_timeout="5.0"
            cube_x="7.7,"
            cube_y="-4.2"
            block_height="0.2"
            grasp_height="0.31"
            goal_data="{arm_goal_data}"
            err_code="{arm_err_code}"
            reason="{arm_reason}"/>
    </Sequence>

    <!-- Optional: set duration_sec to a non-negative value to send 7 floats (joints + duration). -->
  </BehaviorTree>
