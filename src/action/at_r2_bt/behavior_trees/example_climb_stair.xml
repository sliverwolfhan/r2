<?xml version="1.0"?>
<root BTCPP_format="4">
  
  <!-- Simple climb example -->
  <BehaviorTree ID="SimpleClimb">
    <ClimbStair height="0.3" node="{node}" climb_height="{actual_height}"/>
  </BehaviorTree>
  
  <!-- Climb with retry -->
  <BehaviorTree ID="ClimbWithRetry">
    <Retry num_attempts="3">
      <ClimbStair height="0.3" node="{node}" climb_height="{actual_height}"/>
    </Retry>
  </BehaviorTree>
  
  <!-- Navigate and climb sequence -->
  <BehaviorTree ID="NavigateAndClimb">
    <Sequence>
      <!-- Navigate to stair position -->
      <PublishGoal 
        x="1.0" y="2.0" yaw="0.0"
        node="{node}"
        goal="{nav_goal}"/>
      
      <!-- Climb stairs -->
      <ClimbStair height="0.3" node="{node}" climb_height="{actual_height}"/>
      
      <!-- Continue navigation after climbing -->
      <PublishGoal 
        x="3.0" y="4.0" yaw="1.57"
        node="{node}"
        goal="{nav_goal}"/>
    </Sequence>
  </BehaviorTree>
  
</root>
