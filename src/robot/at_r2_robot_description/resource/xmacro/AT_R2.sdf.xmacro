<?xml version="1.0"?>
<sdf version="1.7">

    <!--引入传感器定义-->
    <xmacro_include uri="model://mid360/model.sdf.xmacro" />
    <xmacro_include uri="model://industrial_camera/model.sdf.xmacro" />

    <!--定义可升降麦克纳姆轮（连接到横梁）-->
    <xmacro_define_block name="liftable_mecanum_wheel_on_beam" params="prefix beam_link pose wheel_side">
        <!-- 固定升降臂到横梁 -->
        <joint name="${prefix}_to_beam" type="fixed">
            <pose relative_to="${beam_link}">${pose}</pose>
            <parent>${beam_link}</parent>
            <child>${prefix}_lift_link</child>
        </joint>

        <!-- 升降臂（连接横梁和驱动轮）-->
        <link name="${prefix}_lift_link">
            <pose relative_to="${prefix}_to_beam">0 0 0 0 0 0</pose>
            <inertial>
                <xmacro_block name="inertia_box" m="0.001" x="0.02" y="0.02" z="0.15"/>
            </inertial>
            <visual name="visual">
                <pose>0 0 -0.075 0 0 0</pose>
                <xmacro_block name="geometry_box" x="0.02" y="0.02" z="0.15"/>
                <material>
                    <ambient>0.2 0.5 0.9 1</ambient>
                    <diffuse>0.2 0.5 0.9 1</diffuse>
                </material>
            </visual>
        </link>

        <!-- 驱动轮关节 -->
        <joint name="${prefix}_wheel_joint" type="revolute">
            <pose relative_to="${prefix}_lift_link">0 0 -0.15 0 0 0</pose>
            <parent>${prefix}_lift_link</parent>
            <child>${prefix}_wheel</child>
            <axis>
                <xyz>0 1 0</xyz>
                <limit>
                    <lower>-1.79769e+308</lower>
                    <upper>1.79769e+308</upper>
                    <effort>100</effort>
                    <velocity>100</velocity>
                </limit>
            </axis>
        </joint>

        <!-- 驱动轮 - 麦克纳姆轮 -->
        <link name="${prefix}_wheel">
            <pose relative_to="${prefix}_wheel_joint">0 0 0 0 0 0</pose>
            <inertial>
                <pose>0 0 0 0 0 0</pose>
                <xmacro_block name="inertia_cylinder" m="0.001" r="0.08" l="0.08"/>
            </inertial>
            <visual name="visual">
                <pose>0 0 0 0 1.5708 0</pose>
                <geometry>
                    <mesh>
                        <uri>model://rmua19_standard_robot/meshes/wheel_${wheel_side}.dae</uri>
                    </mesh>
                </geometry>
                <material>
                    <ambient>0.2 0.2 0.2 1</ambient>
                    <diffuse>0.2 0.2 0.2 1</diffuse>
                </material>
            </visual>
            <!-- 使用简化圆柱体碰撞（避免 trimesh 溢出）-->
            <collision name="${prefix}_wheel_collision">
                <pose>0 0 0 1.5708 0 0</pose>
                <geometry>
                    <cylinder>
                        <radius>0.0758</radius>
                        <length>0.08</length>
                    </cylinder>
                </geometry>
                <surface>
                    <friction>
                        <ode>
                            <mu>0.8</mu>
                            <mu2>0.8</mu2>
                        </ode>
                    </friction>
                    <contact>
                        <collide_bitmask>0x01</collide_bitmask>
                    </contact>
                </surface>
            </collision>
        </link>
    </xmacro_define_block>

    <!--定义可升降小轮（连接到横梁）-->
    <xmacro_define_block name="liftable_small_wheel_on_beam" params="prefix beam_link pose rotation">
        <!-- 固定升降臂到横梁 -->
        <joint name="${prefix}_to_beam" type="fixed">
            <pose relative_to="${beam_link}">${pose}</pose>
            <parent>${beam_link}</parent>
            <child>${prefix}_lift_link</child>
        </joint>

        <!-- 升降臂（连接横梁和小轮）-->
        <link name="${prefix}_lift_link">
            <pose relative_to="${prefix}_to_beam">0 0 0 0 0 0</pose>
            <inertial>
                <xmacro_block name="inertia_box" m="0.001" x="0.015" y="0.015" z="0.25"/>
            </inertial>
            <visual name="visual">
                <pose>0 0 -0.125 0 0 0</pose>
                <xmacro_block name="geometry_box" x="0.015" y="0.015" z="0.25"/>
                <material>
                    <ambient>1 0.5 0 1</ambient>
                    <diffuse>1 0.5 0 1</diffuse>
                </material>
            </visual>
        </link>

        <!-- 小轮关节 -->
        <joint name="${prefix}_wheel_joint" type="revolute">
            <pose relative_to="${prefix}_lift_link">0 0 -0.25 0 0 0</pose>
            <parent>${prefix}_lift_link</parent>
            <child>${prefix}_wheel</child>
            <axis>
                <xyz>0 1 0</xyz>
                <limit>
                    <lower>-1.79769e+308</lower>
                    <upper>1.79769e+308</upper>
                    <effort>50</effort>
                    <velocity>100</velocity>
                </limit>
            </axis>
        </joint>

        <!-- 小轮 -->
        <link name="${prefix}_wheel">
            <pose relative_to="${prefix}_wheel_joint">0 0 0 0 0 0</pose>
            <inertial>
                <pose>0 0 0 ${rotation} 0 0</pose>
                <xmacro_block name="inertia_cylinder" m="0.001" r="0.025" l="0.03"/>
            </inertial>
            <visual name="visual">
                <pose>0 0 0 ${rotation} 0 0</pose>
                <xmacro_block name="geometry_cylinder" r="0.025" l="0.03"/>
                <material>
                    <ambient>1 0.5 0 1</ambient>
                    <diffuse>1 0.5 0 1</diffuse>
                </material>
            </visual>
            <collision name="collision">
                <pose>0 0 0 ${rotation} 0 0</pose>
                <xmacro_block name="geometry_cylinder" r="0.025" l="0.03"/>
                <surface>
                    <friction>
                        <ode>
                            <mu>2.0</mu>
                            <mu2>2.0</mu2>
                            <slip1>0.0</slip1>
                            <slip2>0.0</slip2>
                        </ode>
                    </friction>
                </surface>
            </collision>
        </link>
    </xmacro_define_block>

    <!--AT_R2 爬楼梯机器人-->
    <model name="AT_R2">

        <pose>0 0 0.15 0 0 0</pose>

        <!-- 基础坐标系 -->
        <link name="base_footprint"/>
        <link name="base_link"/>

        <joint name="chassis_to_base_footprint" type="fixed">
            <pose>0 0 0.08 0 0 0</pose>
            <parent>base_footprint</parent>
            <child>chassis</child>
        </joint>

        <joint name="base_link_to_base_footptint" type="fixed">
            <pose>0 -0.281 0 0 0 -1.5708</pose>
            <parent>base_footprint</parent>
            <child>base_link</child>
        </joint>

        <!--主底盘-->
        <link name="chassis">
            <inertial>
                <pose>0 0 0.03 0 0 0</pose>
                <xmacro_block name="inertia_box" m="12.0" x="0.8" y="0.8" z="0.12"/>
            </inertial>
            <visual name="chassis_visual">
                <pose>0 0 0.03 0 0 0</pose>
                <xmacro_block name="geometry_box" x="0.8" y="0.8" z="0.12"/>
                <material>
                    <ambient>0.1 0.3 0.4 1</ambient>
                    <diffuse>0.1 0.3 0.4 1</diffuse>
                </material>
            </visual>
            <collision name="chassis_collision">
                <pose>0 0 0.03 0 0 0</pose>
                <xmacro_block name="geometry_box" x="0.6" y="0.4" z="0.12"/>
            </collision>
            <!-- 底盘IMU传感器 -->
            <sensor name="chassis_imu" type="imu">
                <always_on>1</always_on>
                <update_rate>200</update_rate>
            </sensor>
        </link>

        <!--===========================================-->
        <!-- 1. 前驱动轮升降系统（麦克纳姆轮）- 固定不动 -->
        <!--===========================================-->
        <joint name="front_lift_joint" type="fixed">
            <pose relative_to="chassis">0.25 0 0.0658 0 0 0</pose>
            <parent>chassis</parent>
            <child>front_lift_beam</child>
        </joint>

        <link name="front_lift_beam">
            <pose relative_to="front_lift_joint">0 0 0 0 0 0</pose>
            <inertial>
                <xmacro_block name="inertia_box" m="0.001" x="0.02" y="0.56" z="0.02"/>
            </inertial>
            <visual name="visual">
                <xmacro_block name="geometry_box" x="0.02" y="0.56" z="0.02"/>
                <material>
                    <ambient>0.2 0.5 0.9 1</ambient>
                    <diffuse>0.2 0.5 0.9 1</diffuse>
                </material>
            </visual>
            <collision name="collision">
                <xmacro_block name="geometry_box" x="0.02" y="0.56" z="0.02"/>
            </collision>
        </link>

        <xmacro_block name="liftable_mecanum_wheel_on_beam" prefix="front_left" beam_link="front_lift_beam" pose="0 0.28 0 0 0 0" wheel_side="left"/>
        <xmacro_block name="liftable_mecanum_wheel_on_beam" prefix="front_right" beam_link="front_lift_beam" pose="0 -0.28 0 0 0 0" wheel_side="right"/>

        <!--===========================================-->
        <!-- 2. 前辅助轮升降系统（小轮）- 固定不动 -->
        <!--===========================================-->
        <joint name="front_support_lift_joint" type="fixed">
            <pose relative_to="chassis">-0.12 0 -0.09 0 0 0</pose>
            <parent>chassis</parent>
            <child>front_support_lift_beam</child>
        </joint>

        <link name="front_support_lift_beam">
            <pose relative_to="front_support_lift_joint">0 0 0 0 0 0</pose>
            <inertial>
                <xmacro_block name="inertia_box" m="0.001" x="0.015" y="0.56" z="0.015"/>
            </inertial>
            <visual name="visual">
                <xmacro_block name="geometry_box" x="0.015" y="0.56" z="0.015"/>
                <material>
                    <ambient>0.9 0.6 0.1 1</ambient>
                    <diffuse>0.9 0.6 0.1 1</diffuse>
                </material>
            </visual>
            <collision name="collision">
                <xmacro_block name="geometry_box" x="0.02" y="0.56" z="0.02"/>
            </collision>
        </link>

        <xmacro_block name="liftable_small_wheel_on_beam" prefix="front_support_left" beam_link="front_support_lift_beam" pose="0 0.28 0.205 0 0 0" rotation="1.5708"/>
        <xmacro_block name="liftable_small_wheel_on_beam" prefix="front_support_right" beam_link="front_support_lift_beam" pose="0 -0.28 0.205 0 0 0" rotation="-1.5708"/>

        <!--===========================================-->
        <!-- 3. 中间小轮升降系统 - 固定不动 -->
        <!--===========================================-->
        <joint name="mid_lift_joint" type="fixed">
            <pose relative_to="chassis">0.1 0 -0.04 0 0 0</pose>
            <parent>chassis</parent>
            <child>mid_lift_beam</child>
        </joint>

        <link name="mid_lift_beam">
            <pose relative_to="mid_lift_joint">0 0 0 0 0 0</pose>
            <inertial>
                <xmacro_block name="inertia_box" m="0.001" x="0.015" y="0.56" z="0.015"/>
            </inertial>
            <visual name="visual">
                <xmacro_block name="geometry_box" x="0.015" y="0.56" z="0.015"/>
                <material>
                    <ambient>0.9 0.6 0.1 1</ambient>
                    <diffuse>0.9 0.6 0.1 1</diffuse>
                </material>
            </visual>
            <collision name="collision">
                <xmacro_block name="geometry_box" x="0.02" y="0.56" z="0.02"/>
            </collision>
        </link>

        <xmacro_block name="liftable_small_wheel_on_beam" prefix="mid_left" beam_link="mid_lift_beam" pose="0 0.28 0.205 0 0 0" rotation="1.5708"/>
        <xmacro_block name="liftable_small_wheel_on_beam" prefix="mid_right" beam_link="mid_lift_beam" pose="0 -0.28 0.205 0 0 0" rotation="-1.5708"/>

        <!--===========================================-->
        <!-- 4. 后驱动轮升降系统（麦克纳姆轮）- 固定不动 -->
        <!--===========================================-->
        <joint name="rear_lift_joint" type="fixed">
            <pose relative_to="chassis">-0.25 0 0.0658 0 0 0</pose>
            <parent>chassis</parent>
            <child>rear_lift_beam</child>
        </joint>

        <link name="rear_lift_beam">
            <pose relative_to="rear_lift_joint">0 0 0 0 0 0</pose>
            <inertial>
                <xmacro_block name="inertia_box" m="0.001" x="0.02" y="0.56" z="0.02"/>
            </inertial>
            <visual name="visual">
                <xmacro_block name="geometry_box" x="0.02" y="0.56" z="0.02"/>
                <material>
                    <ambient>0.6 0.2 0.8 1</ambient>
                    <diffuse>0.6 0.2 0.8 1</diffuse>
                </material>
            </visual>
            <collision name="collision">
                <xmacro_block name="geometry_box" x="0.02" y="0.56" z="0.02"/>
            </collision>
        </link>

        <xmacro_block name="liftable_mecanum_wheel_on_beam" prefix="rear_left" beam_link="rear_lift_beam" pose="0 0.28 0 0 0 0" wheel_side="right"/>
        <xmacro_block name="liftable_mecanum_wheel_on_beam" prefix="rear_right" beam_link="rear_lift_beam" pose="0 -0.28 0 0 0 0" wheel_side="left"/>

        <!--传感器-->
        <!--3D激光雷达-->
        <xmacro_block name="livox" prefix="mid360" parent="chassis" pose="-0.304 -0.156 0.77 3.1415926 0.0 0.0" update_rate="20" samples="1875"/>
        <!--双目相机-->
        <!-- <xmacro_block name="industrial_camera" prefix="front_left" parent="chassis" pose="0.25 0.1 0.1 0 0 0" update_rate="30" horizontal_fov="1.2" width="1280" height="720"/>
        <xmacro_block name="industrial_camera" prefix="front_right" parent="chassis" pose="0.25 -0.1 0.1 0 0 0" update_rate="30" horizontal_fov="1.2" width="1280" height="720"/> -->

        <!--插件配置-->

        <!--关节状态发布插件-->
        <plugin filename="ignition-gazebo-joint-state-publisher-system"
                name="ignition::gazebo::systems::JointStatePublisher">
        </plugin>

        <!--位姿发布插件（用于发布 TF）-->
        <plugin filename="ignition-gazebo-pose-publisher-system"
                name="ignition::gazebo::systems::PosePublisher">
            <publish_link_pose>true</publish_link_pose>
            <publish_collision_pose>false</publish_collision_pose>
            <publish_visual_pose>false</publish_visual_pose>
            <publish_nested_model_pose>true</publish_nested_model_pose>
            <use_pose_vector_msg>true</use_pose_vector_msg>
            <static_publisher>true</static_publisher>
            <static_update_frequency>10</static_update_frequency>
        </plugin>

        <!--麦克纳姆轮驱动 - 使用 MecanumDrive2 插件（力控模式）-->
        <plugin filename="libMecanumDrive2"
                name="ignition::gazebo::systems::MecanumDrive2">
            <!-- 底盘 Link -->
            <chassis_link>chassis</chassis_link>
            <!-- 四个轮子关节 -->
            <front_left_joint>front_left_wheel_joint</front_left_joint>
            <front_right_joint>front_right_wheel_joint</front_right_joint>
            <rear_left_joint>rear_left_wheel_joint</rear_left_joint>
            <rear_right_joint>rear_right_wheel_joint</rear_right_joint>
        </plugin>

        <!--爬楼梯控制插件 - 简化版本（直接控制机器人整体位置）-->
        <plugin filename="libSimpleStairClimber"
                name="ignition::gazebo::systems::SimpleStairClimber">
            <chassis_link>chassis</chassis_link>
        </plugin>

    </model>
</sdf>
